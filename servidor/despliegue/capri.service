[Unit]
Description=CAPRI — API (etapa 1: Code.js en Node contra los mismos Sheets y Drive)
Documentation=file:///srv/projects/capri/app/docs/servidor-etapa-1.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=capri
Group=capri
WorkingDirectory=/srv/projects/capri/app/servidor
# La zona de Apps Script (appsscript.json): new Date(a, m, d) y getHours() de Code.js dependen de ella
Environment=TZ=America/Mexico_City
Environment=NODE_ENV=production
Environment=CAPRI_CONFIG=/etc/capri/capri.json
ExecStart=/usr/bin/node --max-old-space-size=384 src/index.js
Restart=always
RestartSec=3
# Al detener: deja de aceptar, espera hasta 30 s a lo que está en curso y guarda el caché
TimeoutStopSec=45
KillSignal=SIGTERM

# Endurecimiento: solo puede escribir sus datos; lee su configuración y el código
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ReadWritePaths=/var/lib/capri
ReadOnlyPaths=/etc/capri /srv/projects/capri /opt/capri
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=false
LockPersonality=true
UMask=0077
# Presupuesto: ~350 MB en uso normal; Chromium puede subir 200–300 MB mientras hace PDF (docs §11)
MemoryHigh=900M
MemoryMax=1200M
TasksMax=512

[Install]
WantedBy=multi-user.target
