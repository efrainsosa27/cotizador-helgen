+            neto2 = neto - sale            # el renglón deja de contar lo devuelto
+            hueco = max(0.0, pedido - neto2 - falt)
+            if res == "Reponer":
+                vuelve = min(q, hueco)
+                env = self.envio(r["envio_id"])
