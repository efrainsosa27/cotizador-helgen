+        """{nombre, datos (base64 sin prefijo), mime} → (bytes, None) o (None, error). Solo JPEG: el navegador la
+        comprime a JPEG (lado mayor 1600 px, calidad 0.72) y el cotizador la sirve como image/jpeg."""
+        if not isinstance(d, dict) or not d.get("datos"):
+            return None, f"{que}: falta la foto."
+        datos = re.sub(r"\s+", "", str(d.get("datos")))
+        if datos.startswith("data:"):
+            datos = datos.split(",", 1)[-1]
+        maximo = self.g["MAX_MB"] * 1024 * 1024
+        if len(datos) > maximo * 4 // 3 + 8:
+            return None, f"{que}: la foto pesa más de {self.g['MAX_MB']} MB."
+        try:
+            b = base64.b64decode(datos, validate=True)
+        except (binascii.Error, ValueError):
+            return None, f"{que}: la foto llegó dañada. Vuelve a tomarla."
+        if len(b) > maximo:
+            return None, f"{que}: la foto pesa más de {self.g['MAX_MB']} MB."
+        if b[:3] != b"\xff\xd8\xff":
+            return None, (f"{que}: la foto tiene que ser JPG. Si tu teléfono la guarda en HEIC, tómala con "
+                          "«Tomar foto» (la cámara la entrega en JPG).")
+        return b, None
