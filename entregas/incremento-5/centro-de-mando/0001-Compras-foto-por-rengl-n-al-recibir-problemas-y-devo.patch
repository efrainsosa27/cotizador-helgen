+def _plano(s):
+    """'Cancelar Renglón ' → 'cancelar renglon': para comparar sin acentos ni mayúsculas."""
+    return unicodedata.normalize("NFKD", str(s or "")).encode("ascii", "ignore").decode().lower().strip()
