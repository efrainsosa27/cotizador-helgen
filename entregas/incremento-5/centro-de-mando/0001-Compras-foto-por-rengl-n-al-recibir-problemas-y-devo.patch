+check "Dañado sin foto del problema" 'foto del problema: falta la foto' "$(as jesush -d '{"oc":"OC-2026-0012","renglones":[{"n":2,"recibido":80,'"$F"',"problema":{"tipo":"Dañado","cantidad":10,"comentario":"Rollo aplastado"}}]}' $U/api/compras/recibir)"
+check "tipo de problema inválido" 'elige qué pasó' "$(as jesush -d '{"oc":"OC-2026-0012","renglones":[{"n":2,"recibido":80,'"$F"',"problema":{"tipo":"Robado","cantidad":1,"comentario":"no está"}}]}' $U/api/compras/recibir)"
+check "faltante cuando llegó todo: no" 'si llegó todo no hay faltante' "$(as jesush -d '{"oc":"OC-2026-0012","renglones":[{"n":2,"recibido":80,'"$F"',"problema":{"tipo":"Faltante","cantidad":5,"comentario":"faltan 5"}}]}' $U/api/compras/recibir)"
+check "faltante mayor que lo que no llegó" 'no llegaron 10; el faltante no puede ser de 12' "$(as jesush -d '{"oc":"OC-2026-0012","renglones":[{"n":3,"recibido":0,"problema":{"tipo":"Faltante","cantidad":12,"comentario":"no llegó"}}]}' $U/api/compras/recibir)"
