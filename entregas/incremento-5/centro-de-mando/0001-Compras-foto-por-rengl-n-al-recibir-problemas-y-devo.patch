+#!/usr/bin/env bash
+# Pruebas del 29-oct: incremento 5 de CAPRI del lado del centro de mando — foto por renglón al recibir, «Reportar
+# problema», fotos temporales que el cotizador se lleva a Drive (rutas firmadas) y el aviso oc.devolucion.
+# Contrato: CONTRATO-CAPRI-INCREMENTO-5.md §3–§5. Arranca app.py con carpetas, htpasswd y base SQLite temporales
+# (como tests-1028.sh). No toca el servidor.
+# Uso: bash backend/tests-1029.sh <ruta-a-hbox-docs> [puerto]
+set -u
+REPO=${1:?ruta a hbox-docs}; PORT=${2:-8099}
+T=$(mktemp -d); SEC="secreto-de-pruebas-1029"
+export ACTAS_DIR=$T/actas HTPASSWD_FILE=$T/htpasswd HTPASSWD_LOCK=$T/.lock SESION_COOKIE_INSEGURA=1 \
+  ACTAS_ADMINS=leo PORT INCIDENCIAS_DIR=$T/incidencias INVENTARIO_DIR=$T/inventario TAREAS_DIR=$T/tareas \
+  EQUIPO_DIR=$T/equipo COMPRAS_DB=$T/drogheda.db COTIZADOR_SECRETO=$SEC
+mkdir -p $ACTAS_DIR $T/equipo $T/tareas $T/inventario
+PY=${PYTHON:-python3}
+$PY -c 'import flask, sqlite3' 2>/dev/null || { echo "!! $PY no tiene flask: pip3 install --break-system-packages flask"; exit 2; }
+$PY - "$T" <<'EOF'
+import sys, os, json, sqlite3
+t = sys.argv[1]
+for u, n in [("leo", "Leo"), ("adriana", "Adriana"), ("jesush", "Jesús Honorato"), ("alan", "Alán"),
+             ("miguel", "Miguel"), ("antonio", "Antonio"), ("jesus", "Jesús Romero"), ("claude", "Claude")]:
+    json.dump({"id": u, "nombre": n, "area": "operaciones", "activo": True},
+              open(os.path.join(t, "equipo", u + ".json"), "w"))
+# Una base como la del 28-oct (sin las columnas nuevas), con una OC vieja: la migración al arrancar no debe perderla.
+c = sqlite3.connect(os.path.join(t, "drogheda.db"))
+c.executescript("""
+CREATE TABLE ordenes (folio TEXT PRIMARY KEY, req_folio TEXT, proyecto_folio TEXT, proyecto_clave TEXT,
+  sitio TEXT, sitio_portal TEXT, proveedor TEXT, estado TEXT, fecha_entrega TEXT, paqueteria TEXT, guia TEXT,
+  en_camino_en TEXT, solicitante TEXT, autorizo TEXT, tarea_id TEXT, prueba INTEGER DEFAULT 0,
+  req_cerrada INTEGER DEFAULT 0, recepcion_en TEXT, recepcion_por TEXT, creado_en TEXT, actualizado_en TEXT);
+CREATE TABLE renglones (oc_folio TEXT, n INTEGER, descripcion TEXT, unidad TEXT, cantidad REAL,
+  item_codigo TEXT, item_id TEXT, envio_id TEXT, recibido REAL DEFAULT 0, recibido_en TEXT, recibido_por TEXT,
+  nota TEXT, PRIMARY KEY (oc_folio, n));
+CREATE TABLE eventos (evento_id TEXT PRIMARY KEY, oc_folio TEXT, tipo TEXT, cuando TEXT, quien TEXT,
+  origen TEXT, recibido_en TEXT, datos TEXT);
+INSERT INTO ordenes (folio, sitio, sitio_portal, estado, creado_en) VALUES ('OC-2026-0001','QRO','qro','recibida','2026-10-28T09:00:00');
+INSERT INTO renglones (oc_folio, n, descripcion, unidad, cantidad, recibido, recibido_en, recibido_por)
+  VALUES ('OC-2026-0001', 1, 'Cinta aislante', 'pza', 3, 3, '2026-10-28T10:00:00', 'jesus');
+""")
+c.commit()
+EOF
+if command -v lsof >/dev/null && lsof -nP -iTCP:$PORT -sTCP:LISTEN >/dev/null 2>&1; then
+  echo "!! el puerto $PORT ya está ocupado. Dame otro: bash backend/tests-1029.sh \"$REPO\" 8124"; exit 2
+fi
+$PY $REPO/backend/app.py > $T/app.log 2>&1 &
+APP=$!; trap 'kill $APP 2>/dev/null' EXIT
+U="http://127.0.0.1:$PORT"
+arriba=""
+for _ in $(seq 1 30); do
+  if curl -fsS -o /dev/null "$U/api/salud" 2>/dev/null; then arriba=si; break; fi
+  kill -0 $APP 2>/dev/null || break
+  sleep 0.5
+done
+if [[ -z "$arriba" ]]; then echo "!! app.py no arrancó:"; sed -n '1,40p' $T/app.log; exit 2; fi
+ok=0; fail=0
+# Flask escapa los acentos en JSON («\u00f3»): se comparan ya decodificados, así las pruebas se leen en español.
+dec()   { $PY -c 'import sys,re;print(re.sub(r"\\u([0-9a-fA-F]{4})", lambda m: chr(int(m.group(1), 16)), sys.stdin.read()), end="")'; }
+check() { local v="$3"; [[ "$v" == *'\u'* ]] && v="$(printf '%s' "$v" | dec)"
+          if [[ "$v" == *"$2"* ]]; then ok=$((ok+1)); echo "  ✓ $1"; else fail=$((fail+1)); echo "  ✕ $1 — esperaba «$2», obtuve: ${v:0:300}"; fi; }
+no()    { local v="$3"; [[ "$v" == *'\u'* ]] && v="$(printf '%s' "$v" | dec)"
+          if [[ "$v" != *"$2"* ]]; then ok=$((ok+1)); echo "  ✓ $1"; else fail=$((fail+1)); echo "  ✕ $1 — NO debía traer «$2»: ${v:0:300}"; fi; }
+as()    { curl -s -H "X-Remote-User: $1" -H "Content-Type: application/json" "${@:2}"; }
+sql()   { $PY -c "import sqlite3,sys;c=sqlite3.connect('$T/drogheda.db');print([tuple(r) for r in c.execute(sys.argv[1])])" "$1"; }
+tarea() { $PY -c "import json;d=json.load(open('$T/tareas/$1.json'));print(d['estado'], '|', ' // '.join(h['cambio'] for h in d['historial']))"; }
+inv()   { as leo $U/api/inventario | $PY -c "
+import sys,json;d=json.load(sys.stdin)
+print(' '.join('%s:sitio=%s:camino=%s:total=%s' % (i['codigo'], json.dumps(i['por_sitio'],sort_keys=True).replace(' ',''),
+      json.dumps(i['en_camino'],sort_keys=True).replace(' ',''), i['stock']) for i in d['items']))"; }
+
+# ---- firma (igual que tests-1028.sh) ----
+firma_t() { $PY -c '
+import sys, datetime
+print((datetime.datetime.now().astimezone() + datetime.timedelta(seconds=int(sys.argv[1] or 0))).replace(microsecond=0).isoformat())
+' "${1:-0}"; }
+firma_f() { $PY -c '
+import sys, hmac, hashlib
+print(hmac.new(sys.argv[1].encode(), sys.argv[3].encode() + b"\n" + sys.argv[2].encode(), hashlib.sha256).hexdigest())
+' "${3:-$SEC}" "$1" "$2"; }
+# spost <ruta> <cuerpo> [secreto] [desfase]  ·  sget <ruta> [secreto] [desfase] [curl extra…]
+spost() { local t f; t=$(firma_t "${4:-0}"); f=$(firma_f "$2" "$t" "${3:-$SEC}")
+          curl -s -H "Content-Type: application/json" -H "X-Hbox-Tiempo: $t" -H "X-Hbox-Firma: sha256=$f" -d "$2" "$U$1"; }
+post()  { spost /api/integracion/cotizador/evento "$1"; }
+sget()  { local t f; t=$(firma_t "${3:-0}"); f=$(firma_f "" "$t" "${2:-$SEC}")
+          curl -s -H "X-Hbox-Tiempo: $t" -H "X-Hbox-Firma: sha256=$f" "${@:4}" "$U$1"; }
+
+FOTO=''
+PNG='iVBORw0KGgoAAAANSUhEUgAAAAgAAAAICAIAAABLbSncAAAAFklEQVR4XmPUqDjBgA0wYRVlYBikEgAc5wF4FDd+XgAAAABJRU5ErkJggg=='
+F='"foto":{"nombre":"r.jpg","mime":"image/jpeg","datos":"'$FOTO'"}'
+FP='"foto":{"nombre":"p.jpg","mime":"image/jpeg","datos":"'$FOTO'"}'
+SHA_FOTO=$(printf '%s' "$FOTO" | base64 -d 2>/dev/null | $PY -c 'import sys,hashlib;print(hashlib.sha256(sys.stdin.buffer.read()).hexdigest())')
+DRIVE="https://drive.google.com/file/d/1AbCdEf/view?usp=drivesdk"
+
+echo "## arranque y migración segura"
+check "módulos cargados sin error" "" "$(grep -i 'no se cargó' $T/app.log)"
