+check "la OC de antes de la migración sigue ahí" 'OC-2026-0001' "$(as leo $U/api/compras)"
+
+echo
+echo "## preparar: ítems, OC-2026-0012 a TIMSA en camino"
+as leo -d '{"codigo":"SOP-RTG","descripcion":"Soporte para RTG","categoria":"instalacion","unidad":"pza"}' $U/api/inventario > /dev/null
+as leo -d '{"codigo":"CBL-10","descripcion":"Cable calibre 10","categoria":"cable","unidad":"m"}' $U/api/inventario > /dev/null
+OC12='"oc":{"folio":"OC-2026-0012","req_folio":"REQ-2026-0031","sitio":"ZLO","proveedor":"Ferretería del Pacífico","fecha_entrega":"2026-10-30","guia":"G1","total":99999,"renglones":[{"n":1,"descripcion":"Soporte para RTG","unidad":"pza","cantidad":4,"item":"SOP-RTG","importe":4321},{"n":2,"descripcion":"Cable calibre 10","unidad":"m","cantidad":80,"item":"CBL-10"},{"n":3,"descripcion":"Tornillo 3/8","unidad":"pza","cantidad":10,"item":null}]}'
+post '{"evento_id":"OC-2026-0012:oc.autorizada:1","tipo":"oc.autorizada","quien":"tania@helgen.tech",'"$OC12"'}' > /dev/null
+check "en camino" '"estado_portal":"en-camino"' "$(post '{"evento_id":"OC-2026-0012:oc.en_camino:1","tipo":"oc.en_camino","quien":"tania@helgen.tech",'"$OC12"'}')"
+check "4 soportes y 80 m en camino a TIMSA" 'CBL-10:sitio={}:camino={"timsa":80}' "$(inv)"
+
+echo
+echo "## «Recibir» exige una foto por renglón que llegó"
+R="$(as jesush -d '{"oc":"OC-2026-0012","renglones":[{"n":1,"recibido":4}]}' $U/api/compras/recibir)"
