+    # ---------------------------------------------------------------- problemas (contrato §4 y §5c)
+    def leer_problema(self, d, r, cant, falta, que):
+        """d = {tipo, cantidad, comentario, foto}. cant = lo que llega ahora; falta = lo que faltaba por llegar.
+        Devuelve (problema|None, error|None). Comentario obligatorio; foto obligatoria salvo «Faltante»."""
+        if d in (None, False, "") or (isinstance(d, dict) and not any(d.values())):
+            return None, None
+        if not isinstance(d, dict):
+            return None, f"{que}: el problema llegó mal."
+        tipo = _de_lista(d.get("tipo"), TIPOS_PROBLEMA)
+        if not tipo:
+            return None, f"{que}: elige qué pasó ({', '.join(TIPOS_PROBLEMA)})."
+        q = _num(d.get("cantidad"), -1)
+        if q <= 0:
+            return None, f"{que}: ¿cuántas tienen el problema? Tiene que ser más de 0."
+        pedido = _num(r["cantidad"])
+        if tipo == "Faltante":
+            no_llego = falta - cant
+            if no_llego <= 1e-9:
+                return None, (f"{que}: si llegó todo no hay faltante. Si llegó menos, en «Llegó» anota lo que llegó "
+                              "de verdad.")
+            if q > no_llego + 1e-9:
+                return None, f"{que}: no llegaron {no_llego:g}; el faltante no puede ser de {q:g}."
+        elif tipo != "Sobrante" and q > pedido + 1e-9:
+            return None, f"{que}: se pidieron {pedido:g}; el problema no puede ser de {q:g}."
+        com = self.g["_texto"](d.get("comentario"), 500)
+        if len(com) < MIN_COMENTARIO:
+            return None, f"{que}: escribe qué pasó (el comentario es obligatorio)."
+        foto = None
+        if tipo != "Faltante" or d.get("foto"):
+            foto, e = self.leer_foto(d.get("foto"), f"{que}, foto del problema")
+            if e:
+                return None, e
+        return {"tipo": tipo, "cantidad": q, "comentario": com, "foto": foto}, None
+
+    def anotar_problema(self, c, folio, r, p, quien, ahora):
+        """Guarda la foto del problema y sus columnas. La foto anterior, si no se había archivado, se queda en disco."""
+        pfid = None
+        if p["foto"]:
+            pfid = self.nuevo_foto_id(c, folio, r["n"], problema=True)
+            self.guardar_foto(folio, pfid, p["foto"])
+        c.execute("UPDATE renglones SET problema_tipo=?, problema_cantidad=?, problema_comentario=?, "
+                  "problema_foto_id=?, problema_foto_archivada=0, problema_foto_url=NULL, problema_en=?, "
+                  "problema_por=?, actualizado_en=? WHERE oc_folio=? AND n=?",
+                  (p["tipo"], p["cantidad"], p["comentario"], pfid, ahora, quien, ahora, folio, r["n"]))
+        return pfid
