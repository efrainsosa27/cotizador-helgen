+    def guardar_foto(self, folio, fid, datos):
+        d = self.dir_fotos(folio)
+        os.makedirs(d, exist_ok=True)
+        tmp = os.path.join(d, ".tmp-" + uuid.uuid4().hex[:8] + ".jpg")
+        with open(tmp, "wb") as f:
+            f.write(datos)
+        os.replace(tmp, os.path.join(d, fid + ".jpg"))
