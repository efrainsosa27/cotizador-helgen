+check "base64 dañado" 'llegó dañada' "$(as jesush -d '{"oc":"OC-2026-0012","renglones":[{"n":1,"recibido":4,"foto":{"datos":"@@no-es-base64@@"}}]}' $U/api/compras/recibir)"
+R="$(as jesush -d '{"oc":"OC-2026-0012","renglones":[{"n":1,"recibido":4,'"$F"'},{"n":2,"recibido":80}]}' $U/api/compras/recibir)"
+check "todo o nada: un renglón sin foto detiene la recepción" 'Renglón 2' "$R"
