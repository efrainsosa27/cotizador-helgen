+check "…ni se guardó su foto" "0" "$(ls $T/adjuntos/compras/OC-2026-0012 2>/dev/null | wc -l | tr -d ' ')"
+check "todo en 0 y sin problema: no hay nada que recibir" 'No anotaste nada' "$(as jesush -d '{"oc":"OC-2026-0012","renglones":[{"n":1,"recibido":0},{"n":2,"recibido":0}]}' $U/api/compras/recibir)"
+
+echo
