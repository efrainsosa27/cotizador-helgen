+    # ---------------------------------------------------------------- devoluciones (contrato §5d)
+    def recalcular_estado(self, c, folio):
+        """Estado de la OC según sus renglones, para cuando una devolución la regresa (Reponer) o la completa
+        (faltante aceptado). Devuelve el estado nuevo."""
+        oc = c.execute("SELECT * FROM ordenes WHERE folio=?", (folio,)).fetchone()
+        if not oc or oc["estado"] == "cancelada":
+            return oc["estado"] if oc else None
+        rs = c.execute("SELECT * FROM renglones WHERE oc_folio=?", (folio,)).fetchall()
+        if not rs:
+            return oc["estado"]
+        if all(self.cerrado(r) for r in rs):
+            estado = "recibida"
+        elif any(r["recibido_en"] or _num(r["recibido"]) > 0 for r in rs):
+            estado = "recibida-parcial"
+        elif oc["estado"] in ("recibida", "recibida-parcial"):
+            estado = "en-camino"
+        else:
+            estado = oc["estado"]
+        if estado != oc["estado"]:
+            c.execute("UPDATE ordenes SET estado=?, actualizado_en=? WHERE folio=?", (estado, self.g["ahora"](), folio))
+        return estado
+
+    def sacar_devolucion(self, r, oc, sale, dev, tipo, res, quien):
+        """Movimiento «devolucion» en el sitio de entrega: sale del sitio y del total. Nunca deja el sitio en negativo.
+        Devuelve (movimiento_id|None, cuánto salió, aviso)."""
+        g = self.g
+        it = (g["_leer_json"](g["_ruta_registro"](g["INV_ITEMS"](), r["item_id"])) if r["item_id"] else None) \
+            or self.item_por_codigo(r["item_codigo"])
+        if not it:
+            return None, 0, "el renglón no tiene ítem del inventario: no se descontó nada"
+        entero = _entero_exacto(sale)
+        if entero is None:
+            return None, 0, f"{sale:g} no es un número entero: descuéntalo a mano en Inventario"
+        sitio = oc["sitio_portal"]
+        hay = g["_stock_en_sitio"](it["id"], sitio)
+        sale_i = min(entero, max(0, hay))
+        if sale_i <= 0:
+            return None, 0, f"en {self.codigo(sitio)} ya no había {it.get('codigo')} que descontar"
+        m = g["_registrar_movimiento"](it, "devolucion", sale_i, f"devolución {dev} ({tipo}): {res}"[:200],
+                                       oc["folio"], quien, sitio=sitio)
+        aviso = "" if sale_i == entero else f"en {self.codigo(sitio)} solo había {hay}: se descontaron {sale_i}"
+        return m["id"], sale_i, aviso
