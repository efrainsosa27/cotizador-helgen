+    def nuevo_foto_id(self, c, folio, n, problema=False):
+        """<OC>-r<n>-AAAAMMDDTHHMMSS (y -p- para la del problema), como en el contrato §5a."""
+        base = (f"{carpeta_oc(folio)}-r{n}-" + ("p-" if problema else "")
+                + datetime.datetime.now().strftime("%Y%m%dT%H%M%S"))[:76]
+        fid, k = base, 1
+        while (c.execute("SELECT 1 FROM renglones WHERE foto_id=? OR problema_foto_id=?", (fid, fid)).fetchone()
+               or os.path.exists(os.path.join(self.dir_fotos(folio), fid + ".jpg"))):
+            k += 1
+            fid = f"{base}-{k}"
+        return fid
