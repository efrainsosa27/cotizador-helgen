+    def renglon_de_foto(self, c, fid):
+        """(renglón, clase) de una foto por su id; clase = 'foto' o 'problema_foto' (el prefijo de sus columnas)."""
+        r = c.execute("SELECT * FROM renglones WHERE foto_id=?", (fid,)).fetchone()
+        if r:
+            return r, "foto"
+        r = c.execute("SELECT * FROM renglones WHERE problema_foto_id=?", (fid,)).fetchone()
+        return (r, "problema_foto") if r else (None, None)
