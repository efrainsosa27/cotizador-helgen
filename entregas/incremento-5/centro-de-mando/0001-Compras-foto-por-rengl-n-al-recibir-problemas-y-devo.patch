+    # ---------------------------------------------------------------- cuentas de un renglón
+    @staticmethod
+    def pendiente(r):
+        """Lo que falta por llegar: lo pedido menos lo recibido (neto de devoluciones) y menos el faltante aceptado."""
+        return max(0.0, _num(r["cantidad"]) - _num(r["recibido"]) - _num(r["faltante_aceptado"]))
+
+    @staticmethod
+    def cerrado(r):
+        """Renglón terminado: ya se recibió y no se espera nada más (llegó todo o compras aceptó el faltante)."""
+        return bool(r["recibido_en"]) and _num(r["recibido"]) + _num(r["faltante_aceptado"]) >= _num(r["cantidad"]) - 1e-9
+
