+    def foto_en_espera(r, prueba=False):
+        """La foto de la recepción anterior que el cotizador todavía no se lleva (tras «Reponer» o en una recepción en
+        partes el renglón se vuelve a recibir, y la foto nueva taparía a la anterior). En PRUEBA nunca se espera."""
+        return not prueba and bool(r["foto_id"]) and not r["foto_archivada"]
+
+    def limpiar_pruebas(self, c, folio=None):
+        """Las órdenes de PRUEBA nunca salen en recepciones, así que el cotizador nunca archiva sus fotos: se borran
+        aquí cuando la orden se cierra (recibida o cancelada) o a los DIAS_FOTOS_PRUEBA días. Devuelve cuántas."""
+        limite = time.time() - DIAS_FOTOS_PRUEBA * 86400
+        q = "SELECT folio, estado FROM ordenes WHERE prueba=1" + (" AND folio=?" if folio else "")
+        borradas = 0
+        for oc in c.execute(q, (folio,) if folio else ()).fetchall():
+            d = self.dir_fotos(oc["folio"])
+            if not os.path.isdir(d):
+                continue
+            cerrada = oc["estado"] in ("recibida", "cancelada")
+            for raiz, _, archivos in os.walk(d):
+                for a in archivos:
+                    ruta = os.path.join(raiz, a)
+                    try:
+                        if cerrada or os.path.getmtime(ruta) < limite:
+                            os.remove(ruta)
+                            borradas += 1
+                    except OSError:
+                        pass
+        return borradas
 
