+def _error_jpeg(b):
+    """None si los bytes parecen un JPEG completo; si no, por qué. Barato: SOI al principio, EOI al final y un
+    segmento SOFn con medidas de 1 a FOTO_LADO_MAX px antes de los datos (SOS)."""
+    if len(b) < 128 or b[:3] != b"\xff\xd8\xff":
+        return "no es JPG"
+    if b"\xff\xd9" not in b[-64:]:
+        return "está incompleta (se cortó al subir)"
+    i, n = 2, len(b)
+    while i + 4 <= n:
+        if b[i] != 0xFF:
+            return "está dañada"
+        m = b[i + 1]
+        if m == 0xFF:                                   # relleno entre marcadores
+            i += 1
+            continue
+        if m == 0x01 or 0xD0 <= m <= 0xD7:              # marcadores sin longitud
+            i += 2
+            continue
+        largo = int.from_bytes(b[i + 2:i + 4], "big")
+        if largo < 2 or i + 2 + largo > n:
+            return "está dañada"
+        if m in (0xC0, 0xC1, 0xC2, 0xC3, 0xC5, 0xC6, 0xC7, 0xC9, 0xCA, 0xCB, 0xCD, 0xCE, 0xCF):
+            if largo < 7:
+                return "está dañada"
+            alto = int.from_bytes(b[i + 5:i + 7], "big")
+            ancho = int.from_bytes(b[i + 7:i + 9], "big")
