+function urlDriveValida(url) {
+  if (typeof url !== 'string' || !url || url.length > 500 || url.includes('@') || url.includes('\\')) return false;
+  if ([...url].some(ch => ch.charCodeAt(0) < 0x21 || ch.charCodeAt(0) === 0x7f)) return false;
