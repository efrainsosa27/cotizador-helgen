+    // ---- Mis requisiciones: devoluciones, fotos (si tienes acceso a la carpeta) y "Reportar problema" ----
+    function htmlDevSolicitante(r) {
+      const partes = [];
+      if ((r.devoluciones || []).length) {
+        partes.push('<div class="nota" style="margin-top:6px"><b>Problemas reportados:</b><br>' + r.devoluciones.map(d => '<b>' + esc(d.folio) + '</b> · ' +
+          esc(d.tipo) + ' · ' + textoMaterial(Object.assign({ unidad: '' }, d)) + ' · ' + (d.estado === 'Abierta' ? '<span class="aviso-moneda">por resolver</span>'
+          : 'resuelta: ' + esc(d.resolucion) + (d.guia ? ' (guía ' + esc(d.guia) + ')' : ''))).join('<br>') + '</div>');
+      }
+      if ((r.fotos || []).length) {
+        partes.push('<div class="nota" style="margin-top:4px"><b>Fotos:</b> ' + r.fotos.map(x => esc(x.folio) + ' r' + esc(x.renglon) + ' ' + ligaFoto(x.url)).join(' · ') + '</div>');
+      }
+      if ((r.reportables || []).length && !(RD.reporte && RD.reporte.folio === r.folio && RD.reporte.desde === 'req')) {
+        partes.push('<div class="acciones" style="margin-top:6px">' + botonChico('Reportar problema', "RECEPCION.abrirReporte(" + jsArg(r.folio) + ",'req')") + '</div>');
+      }
+      partes.push('<div id="devForm-' + esc(r.folio) + '"></div>');
+      return partes.join('');
+    }
+    function pintarMisReqDev(lista) {
+      if (RD.reporte && RD.reporte.desde === 'req') RD.reporte = null; // la lista se volvió a pintar: el formulario ya no está
+      (lista || []).forEach(r => { const caja = $('devCaja-' + r.folio); if (caja) caja.innerHTML = htmlDevSolicitante(r); });
+    }
+
+    // ---- Compras: la requisición (fotos, devoluciones, reportar y resolver) ----
+    function htmlResolver(clave, dv) {
+      return '<div class="sat" style="margin-top:8px;background:#fff"><div class="sat-titulo">Resolver ' + esc(dv.folio) + '</div>' +
+        '<div class="nota">' + esc(dv.tipo) + ' · ' + textoMaterial(dv) + ' · reportó ' + esc(dv.reporto) + (dv.origen === 'Centro de mando' ? ' (centro de mando)' : '') +
+        (dv.comentario ? '<br><b>Comentario:</b> ' + esc(dv.comentario) : '') + (dv.fotoUrl ? '<br>' + ligaFoto(dv.fotoUrl) : dv.fotoPendiente ? '<br>La foto llega del centro de mando en unos minutos.' : '') + '</div>' +
+        '<div class="grid" style="margin-top:6px"><div><label>Resolución *</label><select id="' + clave + 'Res" onchange="RECEPCION.ayudaRes(\'' + clave + '\')">' +
+        RESOLUCIONES.map(x => '<option>' + x + '</option>').join('') + '</select></div>' +
+        '<div><label>Guía de la devolución (opcional)</label><input id="' + clave + 'Guia" maxlength="60"></div>' +
+        '<div style="grid-column:1/-1"><label>Nota (obligatoria al devolver o cancelar)</label><input id="' + clave + 'Nota" maxlength="500" placeholder="Ej. Nota de crédito NC-123"></div></div>' +
+        '<div id="' + clave + 'Ayuda" class="nota">' + esc(AYUDA_RES.Reponer) + '</div>' +
+        '<div class="acciones"><button type="button" id="' + clave + 'Btn" class="btn" onclick="RECEPCION.resolver()">Resolver</button>' +
+        '<button type="button" class="btn btn-sec" onclick="RECEPCION.cerrarResolver()">Cancelar</button></div></div>';
+    }
+    function pintarCompras(v) {
+      const caja = $('rcDevoluciones');
+      if (!caja) return;
+      const fotos = [];
+      (v.recepciones || []).forEach(x => (x.renglones || []).forEach(y => { if (y.fotoUrl) fotos.push(esc(x.folio) + ' r' + esc(y.renglon) + ' ' + ligaFoto(y.fotoUrl)); }));
+      (v.fotosRecogido || []).forEach(x => fotos.push('Lo recogí r' + esc(x.renglon) + ' ' + ligaFoto(x.url)));
+      const devs = v.devoluciones || [];
+      const hay = fotos.length || devs.length || (v.reportables || []).length;
+      caja.classList.toggle('oculto', !hay);
+      if (!hay) { caja.innerHTML = ''; return; }
+      const abiertoRes = RD.resolver && RD.resolver.desde === 'com' && devs.some(d => d.folio === RD.resolver.folio && d.puedeResolver) ? RD.resolver : null;
+      if (RD.resolver && RD.resolver.desde === 'com' && !abiertoRes) RD.resolver = null;
+      caja.innerHTML = '<div class="sat-titulo">Fotos y devoluciones</div>' +
+        (fotos.length ? '<div class="nota"><b>Fotos de lo que llegó:</b> ' + fotos.join(' · ') + '</div>' : '') +
+        (devs.length ? '<div class="tabla-desliza"><table style="font-size:12px;margin-top:6px"><thead><tr><th>Folio</th><th>Material</th><th>Problema</th><th>Reportó</th><th>Estado</th><th></th></tr></thead><tbody>' +
+          devs.map(d => '<tr><td><b>' + esc(d.folio) + '</b><div class="nota">' + esc(fechaMx(d.fecha)) + '</div></td><td>' + textoMaterial(d) + '</td><td>' + esc(d.tipo) +
+            (d.comentario ? '<div class="nota">' + esc(d.comentario) + '</div>' : '') + (d.fotoUrl ? '<div>' + ligaFoto(d.fotoUrl) + '</div>' : '') + '</td><td>' + esc(d.reporto) +
+            (d.origen === 'Centro de mando' ? '<div class="nota">centro de mando</div>' : '') + '</td><td>' + (d.estado === 'Abierta' ? '<span class="chip aceptada">Abierta</span>'
+            : '<span class="chip firmado">' + esc(d.resolucion) + '</span>' + (d.notaResolucion ? '<div class="nota">' + esc(d.notaResolucion) + '</div>' : '') +
+              (d.guia ? '<div class="nota">Guía ' + esc(d.guia) + '</div>' : '')) + '</td><td>' +
+            (d.puedeResolver ? botonChico('Resolver', "RECEPCION.abrirResolver(" + jsArg(d.folio) + ",'com')", false) : '') + '</td></tr>').join('') + '</tbody></table></div>' : '') +
+        '<div id="rcDevResolver"></div>' +
+        ((v.reportables || []).length && !(RD.reporte && RD.reporte.desde === 'com') ? '<div class="acciones" style="margin-top:6px">' +
+          botonChico('Reportar problema', "RECEPCION.abrirReporte(" + jsArg(v.requisicion.folio) + ",'com')") + '</div>' : '') +
+        '<div id="rcDevForm"></div>';
+      if (abiertoRes) { const dv = devs.find(d => d.folio === abiertoRes.folio); $('rcDevResolver').innerHTML = htmlResolver(abiertoRes.clave, dv); }
+      if (RD.reporte && RD.reporte.desde === 'com') {
+        if (RD.reporte.folio === v.requisicion.folio && (v.reportables || []).length) $('rcDevForm').innerHTML = htmlReporte(RD.reporte.clave, RD.reporte.folio, v.reportables);
+        else RD.reporte = null;
+      }
+    }
+
+    // ---- Compras: lista de devoluciones y resolución ----
+    function cargarDevoluciones() {
+      if (!PERMISOS.compras && !PERMISOS.superadmin) return;
+      RD.cargando = true;
+      google.script.run.withSuccessHandler(l => { RD.cargando = false; pintarLista(l); })
+        .withFailureHandler(err => { RD.cargando = false; mostrarError(err); }).listarDevoluciones({ estado: $('devEstado').value });
+    }
+    function pintarLista(l) {
+      if (RD.resolver && RD.resolver.desde === 'lista') { RD.listaPendiente = l; return; } // no se borra lo capturado
+      RD.lista = l || [];
+      $('devLista').innerHTML = RD.lista.length ? RD.lista.map(d => '<tr><td><b>' + esc(d.folio) + '</b>' + (d.origen === 'Centro de mando' ? '<div class="nota">centro de mando</div>' : '') +
+        '</td><td>' + esc(fechaMx(d.fecha)) + '</td><td><a href="#" onclick="RECEPCION.abrirReq(' + jsArg(d.reqFolio) + ');return false">' + esc(d.reqFolio) + '</a><div class="nota">' +
+        esc(d.proyectoVisible) + ' · ' + esc(d.proyectoNombre) + '</div></td><td>' + textoMaterial(d) + '</td><td>' + esc(d.tipo) +
+        (d.comentario ? '<div class="nota">' + esc(d.comentario) + '</div>' : '') + (d.fotoUrl ? '<div>' + ligaFoto(d.fotoUrl) + '</div>' : '') + '</td><td>' + esc(d.reporto) +
+        '</td><td>' + (d.estado === 'Abierta' ? '<span class="chip aceptada">Abierta</span>' : '<span class="chip firmado">' + esc(d.resolucion) + '</span>') + '</td><td>' +
+        (d.puedeResolver ? botonChico('Resolver', "RECEPCION.abrirResolver(" + jsArg(d.folio) + ",'lista')", false) : '') + '</td></tr>').join('')
+        : '<tr><td colspan="8" class="nota">No hay devoluciones' + ($('devEstado').value === 'Abierta' ? ' por resolver' : '') + '.</td></tr>';
+    }
+    function abrirResolver(folio, desde) {
+      const dv = desde === 'com' ? ((REQC && REQC.devoluciones) || []).find(d => d.folio === folio) : (RD.lista || []).find(d => d.folio === folio);
+      if (!dv || !dv.puedeResolver) return;
+      cerrarResolver();
+      const clave = 'dvs' + desde + folio.replace(/[^A-Za-z0-9]/g, '');
+      RD.resolver = { folio: folio, desde: desde, clave: clave, id: nuevoId() };
+      $(desde === 'com' ? 'rcDevResolver' : 'devResolver').innerHTML = htmlResolver(clave, dv);
+    }
+    function cerrarResolver() {
+      const r = RD.resolver;
+      if (!r) return;
+      RD.resolver = null;
+      const caja = $(r.desde === 'com' ? 'rcDevResolver' : 'devResolver');
+      if (caja) caja.innerHTML = '';
+      if (r.desde === 'lista' && RD.listaPendiente) { const l = RD.listaPendiente; RD.listaPendiente = null; pintarLista(l); }
+    }
+    function ayudaRes(clave) { const a = $(clave + 'Ayuda'); if (a) a.textContent = AYUDA_RES[$(clave + 'Res').value] || ''; }
+    function resolver() {
+      const r = RD.resolver, k = r && r.clave, b = k && $(k + 'Btn');
+      if (!r || !b || b.disabled) return;
+      const d = { resolucion: $(k + 'Res').value, nota: $(k + 'Nota').value, guia: $(k + 'Guia').value, idSolicitud: r.id };
+      if ((d.resolucion === 'Devolver al proveedor' || d.resolucion === 'Cancelar renglón') && String(d.nota || '').trim().length < 5) {
+        mostrarError(d.resolucion === 'Devolver al proveedor' ? 'Escribe la nota de la devolución (nota de crédito o reembolso).' : 'Escribe por qué se cancela el renglón.');
+        return;
+      }
+      if (!window.confirm('¿Resolver ' + r.folio + ' como "' + d.resolucion + '"? ' + (AYUDA_RES[d.resolucion] || '') + '.')) return;
+      b.disabled = true; b.textContent = 'Resolviendo…';
+      google.script.run.withSuccessHandler(x => {
+        RD.resolver = null; RD.listaPendiente = null;
+        if (x.vista && REQC && REQC.requisicion.folio === x.vista.requisicion.folio) pintarReqCom(x.vista);
+        if ($('devEstado').value === 'Abierta' && x.devoluciones) pintarLista(x.devoluciones); else if (RD.lista) cargarDevoluciones();
+        if (r.desde === 'lista') $('devResolver').innerHTML = '';
+        aviso('ok', 'Devolución <b>' + esc(x.folio) + '</b> resuelta: ' + esc(d.resolucion) + '. La requisición quedó <b>' + esc(x.estado) + '</b>.' + extraPortal(x));
+      }).withFailureHandler(err => { b.disabled = false; b.textContent = 'Resolver'; mostrarError(err); }).resolverDevolucion(r.folio, d);
+    }
+    function abrirReq(folio) { if (typeof abrirReqCom === 'function') abrirReqCom(folio); }
+
+    window.RECEPCION = { problema: problema, abrirReporte: abrirReporte, cerrarReporte: cerrarReporte, enviarReporte: enviarReporte,
+      cargarDevoluciones: cargarDevoluciones, abrirResolver: abrirResolver, cerrarResolver: cerrarResolver, resolver: resolver, ayudaRes: ayudaRes,
+      abrirReq: abrirReq, comprimirFoto: comprimirFoto };
+
+    registrarModulo({
+      nombre: 'Recepción',
+      alPermisos(permisos, solo) {
+        const com = !!permisos && !solo && (permisos.compras || permisos.superadmin);
+        $('comModDevoluciones').classList.toggle('oculto', !com);
+        if (!com) { RD.lista = null; $('devLista').innerHTML = ''; }
+      },
+      alVerTab(t) { if (t === 'com' && BOOT && !RD.lista && !RD.cargando) cargarDevoluciones(); },
+      // La sincronización manda la lista otra vez cuando cambia algo (con el estado elegido)
+      contexto() { return RD.lista && TAB === 'com' ? { devoluciones: { estado: $('devEstado').value } } : {}; },
+      alSincronizar(r) { if (r && r.devoluciones && RD.lista) pintarLista(r.devoluciones); },
+      alMisReq(lista) { pintarMisReqDev(lista); },
+      alVistaReqCom(v) { pintarCompras(v); },
+    });
+  })();
+</script>
 </body>
