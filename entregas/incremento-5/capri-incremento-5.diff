+  (res.fotos || []).filter(f => !vistas[f.id] && (vistas[f.id] = true)).slice(0, MAX_FOTOS_PORTAL).forEach(tarea => {
+    try {
+      let url = cache.get('FOTOCM_' + tarea.id) || ''; // ya está en Drive: solo falta avisar que se archivó
+      if (!url) {
