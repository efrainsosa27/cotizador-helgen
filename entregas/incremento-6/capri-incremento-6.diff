+}
+
+// ================= 2. Idempotencia del pago (r2, r6) =================
+{
+  // El caché simulado es como el de Apps Script: un valor de más de 100 KB no se guarda (lanza)
+  const c = A.ctx.CacheService.getScriptCache();
