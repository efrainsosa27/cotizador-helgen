+    getMaxColumns() { return this.h.columnasMax; }
+    getFrozenRows() { return this.h.congeladas; }
+    getDataRange() {
+      return new Rango(this.libroId, this.hojaId, 1, 1, Math.max(1, M.ultimaFila(this.h)), Math.max(1, M.ultimaColumna(this.h)));
