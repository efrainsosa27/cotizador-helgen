+async function leerCuerpo(d) {
+  if (d == null) return null;
+  if (d instanceof Readable || (d && typeof d.pipe === 'function')) {
+    const trozos = [];
+    for await (const x of d) trozos.push(Buffer.from(x));
+    return Buffer.concat(trozos);
+  }
+  return d;
