+  let base;
+  try { base = leerCfdi(texto); } catch (e) { throw new Error(textoErrorCfdiCliente(e.message)); }
+  const s = String(texto).replace(/^﻿/, '').replace(/<!--[\s\S]*?-->/g, '');
+  const re = /<(\/?)(?:[A-Za-z_][\w.\-]*:)?([A-Za-z_][\w.\-]*)((?:\s+[^\s=\/>]+\s*=\s*(?:"[^"]*"|'[^']*'))*)\s*(\/?)>/g;
