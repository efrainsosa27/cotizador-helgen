+    if (!h || !h.correo || !h.semana || !h.proyecto) return;
+    const k = claveBloqueHoras(h);
+    let b = porClave[k];
+    if (!b) {
+      b = porClave[k] = { correo: String(h.correo).toLowerCase(), nombre: h.nombre || '', semana: h.semana, proyecto: folioInterno(h.proyecto),
