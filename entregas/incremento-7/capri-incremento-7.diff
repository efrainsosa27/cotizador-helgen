+
+/** 'Adicional' si el valor lo dice (sin acentos ni mayúsculas); si no, '' (cotización normal). */
+function tipoCotizacion(valor) {
+  return textoNormal(valor) === 'adicional' ? TIPO_ADICIONAL : '';
