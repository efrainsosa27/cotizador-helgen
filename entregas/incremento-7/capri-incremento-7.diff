+  if (f.emisor.rfc !== rfcHelgen) {
+    throw new Error('Este XML lo emitió ' + (corto(f.emisor.nombre) || 'otra empresa') + ' (' + (corto(f.emisor.rfc) || 'sin RFC') + '), no Helgen (' +
