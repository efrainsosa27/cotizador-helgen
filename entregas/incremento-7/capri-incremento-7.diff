+class AuthFalso {
+  constructor() { this.rutas = []; this.peticiones = []; }
+  en(metodo, re, fn) { this.rutas.push({ metodo, re, fn }); return this; }
+  getUniverseDomain() { return 'googleapis.com'; }
+  async request(o) {
+    const metodo = String(o.method || 'GET').toUpperCase();
