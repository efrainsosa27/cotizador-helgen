+      let resto = cts(total);
+      return elegidas.map((e, i) => {
+        const falta = Math.max(0, cupo(e, f) + (nota ? -1 : 1) * (propias[e.clave] || 0));
+        const toma = i === elegidas.length - 1 ? resto : Math.min(falta, resto);
+        resto -= toma;
+        return { clave: e.clave, etapa: e.etapa, monto: toma / 100 };
+      }).filter(x => x.monto > 0);
+    }
+    function formLiga(f) {
+      if (!est.liga || est.liga.uuid !== f.uuid) est.liga = ligaInicial(f);
+      const L = est.liga, u = idDe(f.uuid), p = proyectoDe(L.proyecto);
+      const opciones = ((est.lista && est.lista.proyectos) || []).filter(x => x.moneda === f.moneda && x.estadoProyecto !== 'Cancelado');
+      const sug = (f.sugerencias || []).map((s, i) => '<div class="sat-op" onclick="FACTURAS_CLI.sugerencia(' + jsArg(f.uuid) + ',' + i + ')"><b>' +
+        esc(s.folioVisible) + '</b><span>' + esc(s.nombre) + ' · ' + esc(s.cliente) + '<small class="sat-razon">' + esc(s.razon) + '</small></span></div>').join('');
+      const etapas = p ? (p.etapas || []).map(e => {
+        const k = idDe(e.clave), elegida = L.claves.indexOf(e.clave) !== -1;
+        return '<tr><td><input type="checkbox" id="facEt-' + u + '-' + k + '"' + (elegida ? ' checked' : '') + ' style="width:auto" onchange="FACTURAS_CLI.etapa(' +
+          jsArg(f.uuid) + ',' + jsArg(e.clave) + ',this.checked)"></td><td>' + esc(e.etapa) + '</td><td class="num">' + dinero(e.monto, p.moneda) +
+          '</td><td class="num">' + dinero(e.facturado, p.moneda) + '</td><td class="num">' + dinero(e.porFacturar, p.moneda) + '</td><td>' +
+          '<input id="facMonto-' + u + '-' + k + '" type="number" min="0" step="0.01" style="text-align:right;max-width:140px" placeholder="automático" value="' +
+          esc(L.montos[e.clave] || '') + '" oninput="FACTURAS_CLI.monto(' + jsArg(f.uuid) + ',' + jsArg(e.clave) + ',this.value)"></td></tr>';
+      }).join('') : '';
+      const rep = p ? reparto(p, L.claves, f.total, f) : [];
+      return '<tr class="fac-liga"><td colspan="7"><div class="sat" style="margin-top:0"><div class="sat-titulo">' + (f.ligada ? 'Cambiar la liga de ' : 'Ligar ') +
+        esc(doc(f)) + ' · ' + dinero(f.total, f.moneda) + ' · ' + esc(f.receptorNombre) + '</div>' +
+        (f.tipo === 'E' ? '<div class="nota" style="margin-bottom:6px">Su factura relacionada no está en CAPRI: ligada aquí, la nota de crédito resta de las etapas elegidas.</div>' : '') +
+        (sug ? '<div class="nota" style="margin-bottom:4px">Sugerencias (por RFC del cliente, razón social y monto):</div>' + sug : '<div class="nota">Sin sugerencias: elige el proyecto.</div>') +
+        '<div style="margin-top:10px"><label>Proyecto (con cotización aceptada, en ' + esc(f.moneda) + ')</label><select id="facProy-' + u + '" onchange="FACTURAS_CLI.proyecto(' +
+        jsArg(f.uuid) + ',this.value)"><option value="">Elige el proyecto…</option>' + opciones.map(x => '<option value="' + esc(x.folio) + '"' +
+        (x.folio === L.proyecto ? ' selected' : '') + '>' + esc(x.folioVisible + ' — ' + x.cliente + ' — ' + x.nombre) + (x.estadoContrato === 'Firmado' ? '' : ' (por firmar)') +
+        '</option>').join('') + '</select></div>' +
+        (p ? '<div class="tabla-desliza" style="margin-top:8px"><table style="font-size:12px"><thead><tr><th></th><th>Etapa</th><th class="num">Monto</th>' +
+          '<th class="num">Facturado</th><th class="num">Por facturar</th><th>Monto de esta factura (opcional)</th></tr></thead><tbody>' + etapas + '</tbody></table></div>' +
+          '<div class="nota" id="facReparto-' + u + '">' + (rep.length ? 'Sin montos se reparte así: ' + rep.map(x => esc(x.etapa) + ' ' + dinero(x.monto, f.moneda)).join(' + ')
+            : 'Elige una o varias etapas.') + '</div>' : '') +
+        '<div class="acciones"><button type="button" class="btn" id="btnFacLigar" onclick="FACTURAS_CLI.ligar(' + jsArg(f.uuid) + ')">' + (f.ligada ? 'Cambiar liga' : 'Ligar') + '</button>' +
+        '<button type="button" class="btn btn-sec" onclick="FACTURAS_CLI.cerrarLiga()">Cerrar</button></div>' +
+        '<div class="nota" style="margin-top:10px">¿No es de un proyecto de CAPRI (p. ej. una venta que no se lleva aquí)? Escribe el motivo:</div>' +
+        '<div class="acciones" style="margin-top:4px"><input id="facSinMotivo-' + u + '" maxlength="500" value="' + esc(L.motivo) + '" placeholder="Motivo" ' +
+        'oninput="FACTURAS_CLI.motivo(' + jsArg(f.uuid) + ',this.value)" style="flex:1; min-width:200px"><button type="button" class="btn btn-sec" ' +
+        'onclick="FACTURAS_CLI.sinProyecto(' + jsArg(f.uuid) + ')">Marcar sin proyecto</button></div></div></td></tr>';
+    }
+    function abrirLiga(uuid) {
+      const f = factura(uuid);
+      if (!f) return;
+      est.abierta = uuid; est.liga = ligaInicial(f);
+      pintarTabla();
+    }
+    function ligar(uuid) {
+      const L = est.liga, f = factura(uuid);
+      if (!f || !L || L.uuid !== uuid || est.ligando) return;
+      const p = proyectoDe(L.proyecto);
+      if (!p) { aviso('error', 'Elige el proyecto.'); return; }
+      const etapas = (p.etapas || []).filter(e => L.claves.indexOf(e.clave) !== -1);
+      if (!etapas.length) { aviso('error', 'Elige al menos una etapa.'); return; }
+      const montos = etapas.map(e => String(L.montos[e.clave] == null ? '' : L.montos[e.clave]).trim());
+      const con = montos.filter(Boolean).length;
+      if (con && con !== etapas.length) { aviso('error', 'Escribe el monto de todas las etapas elegidas o de ninguna (sin montos se reparte solo).'); return; }
+      est.ligando = true;
+      llamar('ligarFacturaCliente', { uuid: uuid, proyectoFolio: p.folio, etapas: etapas.map((e, i) => ({ clave: e.clave, monto: con ? montos[i] : '' })) })
+        .then(r => {
+          est.ligando = false; est.abierta = ''; est.liga = null;
+          recibir(r.lista);
+          aviso('ok', esc(doc(f)) + ' ligada a <b>' + esc(p.folioVisible) + '</b> (' + esc(etapas.map(e => e.etapa).join(' + ')) + ').');
+        }, err => { est.ligando = false; mostrarError(err); });
+    }
+    function sinProyecto(uuid) {
+      const L = est.liga, f = factura(uuid);
+      if (!f || !L || L.uuid !== uuid || est.ligando) return;
+      const m = String(L.motivo || '').trim();
+      if (m.length < 5) { aviso('error', 'Escribe por qué la factura no es de un proyecto de CAPRI.'); return; }
+      est.ligando = true;
+      llamar('ligarFacturaCliente', { uuid: uuid, sinProyecto: m }).then(r => {
+        est.ligando = false; est.abierta = ''; est.liga = null;
+        recibir(r.lista);
+        aviso('ok', esc(doc(f)) + ' marcada sin proyecto.');
+      }, err => { est.ligando = false; mostrarError(err); });
+    }
+    function cancelar(uuid, desde) {
+      const f = factura(uuid) || { uuid: uuid, tipoTexto: 'Factura', serieFolio: '' };
+      const m = window.prompt('Marcar ' + doc(f) + ' como Cancelada (solo si ya se canceló en CONTALINK). Motivo:');
+      if (m === null) return;
+      if (String(m).trim().length < 5) { aviso('error', 'Escribe el motivo de la cancelación.'); return; }
+      llamar('cancelarFacturaCliente', uuid, String(m).trim(), desde || '').then(r => {
+        recibir(r.lista);
+        if (r.vista) pintarCobranza(r.vista);
+        aviso('ok', esc(doc(f)) + ' marcada como Cancelada.');
+      }, mostrarError);
+    }
+
+    /** Desde Pendientes: Cobranza → resumen → la factura (con su liga abierta si está sin ligar). */
+    function abrir(uuid, tipo) {
+      if (!puede()) { aviso('error', 'Tu cuenta no tiene acceso a Cobranza.'); return; }
+      verTab('cob');
+      verResumenCob();
+      est.vista = 'atender'; est.buscar = ''; est.tipo = ''; est.resaltar = uuid || '';
+      if (uuid && tipo === 'facSinLigar') { est.abierta = uuid; est.liga = null; }
+      if (!est.lista || (uuid && !factura(uuid))) cargar(); else pintar(); // la factura llegó después de la lista: se pide otra vez
+      const caja = $('cobModFacturas');
+      if (caja && caja.scrollIntoView && !est.resaltar) caja.scrollIntoView({ behavior: 'smooth', block: 'start' });
+    }
+
+    // ---- Facturas por etapa en la vista de cobranza del proyecto (v.facturas, de vistaCobranza_) ----
+    function pintarBloque(v) {
+      const caja = $('cobFacturas'), b = v && v.facturas, c = v && v.contrato;
+      if (!b || !puede() || (!c && !(b.porRevisar || []).length && !b.error)) { caja.classList.add('oculto'); caja.innerHTML = ''; return; }
+      caja.classList.remove('oculto');
+      if (b.error) { caja.innerHTML = '<div class="nota aviso-moneda" style="margin-top:14px">' + esc(b.error) + '</div>'; return; }
+      const mon = c ? c.moneda : 'MXN', t = b.totales || {};
+      const facturasDe = e => (e.facturas || []).map(x => '<div style="white-space:nowrap"><b>' + esc(x.serieFolio || x.uuid.slice(0, 8)) + '</b> ' +
+        esc(x.metodo || '') + ' ' + dinero(x.total, x.moneda || mon) + (x.total !== x.totalFactura ? ' <span class="nota">de ' + dinero(x.totalFactura, x.moneda || mon) + '</span>' : '') +
+        (x.repPendiente ? ' ' + chip('cancelado', 'REP pendiente', 'Falta REP por ' + dinero(x.porCubrirRep, x.moneda || mon).replace(/<[^>]+>/g, ''))
+          : x.metodo === 'PPD' && x.repCubierto > 0 ? ' ' + chip('firmado', 'REP') : '') +
+        (x.pdfUrl ? ' <a href="' + esc(x.pdfUrl) + '" target="_blank">PDF</a>' : '') + (x.xmlUrl ? ' <a href="' + esc(x.xmlUrl) + '" target="_blank">XML</a>' : '') + '</div>').join('') ||
+        '<span class="nota">Sin facturas</span>';
+      caja.innerHTML = '<div class="sat" style="margin-top:14px"><div class="sat-titulo">Facturas por etapa (CONTALINK)</div>' +
+        '<div class="tiles">' + tile('Facturado (con IVA)', dinero(t.facturado || 0, mon)) + tile('Cobrado', dinero(t.cobrado || 0, mon)) +
+        tile('Por facturar', dinero(t.porFacturar || 0, mon), cts(t.porFacturar) < 0) + tile('REP pendientes', String(b.repPendientes || 0), b.repPendientes > 0) + '</div>' +
+        ((b.etapas || []).length ? '<div class="tabla-desliza"><table style="font-size:12px"><thead><tr><th>Etapa</th><th class="num">Monto</th><th class="num">Facturado</th>' +
+          '<th class="num">Cobrado</th><th class="num">Por facturar</th><th>Facturas</th></tr></thead><tbody>' + b.etapas.map(e => '<tr><td>' + esc(e.etapa) +
+          '</td><td class="num">' + dinero(e.monto, mon) + '</td><td class="num">' + dinero(e.facturado, mon) + '</td><td class="num">' + dinero(e.cobrado, mon) +
+          '</td><td class="num"' + (cts(e.porFacturar) < 0 ? ' title="Facturado de más"' : '') + '>' + dinero(e.porFacturar, mon) + '</td><td>' + facturasDe(e) +
+          '</td></tr>').join('') + '</tbody></table></div>' : '') +
+        ((b.porRevisar || []).length ? '<div class="nota aviso-moneda" style="margin-top:8px">Por revisar: ' + b.porRevisar.map(x => esc(x.serieFolio || x.uuid.slice(0, 8)) +
+          ' — ' + esc(x.revisar)).join('<br>') + '</div>' : '') +
+        (b.sinLigarCliente ? '<div class="nota" style="margin-top:8px">Hay ' + plural(b.sinLigarCliente, 'factura', 'facturas') + ' de este cliente sin ligar: ' +
+          '<a href="#" onclick="FACTURAS_CLI.abrir();return false">' + (b.sinLigarCliente === 1 ? 'ligarla' : 'ligarlas') + ' en Facturas de clientes</a>.</div>' : '') +
+        '<div class="nota" style="margin-top:8px">Facturado = facturas ligadas a la etapa menos sus notas de crédito; cobrado = pagos registrados en Cobranza. ' +
+        '"REP pendiente": una factura PPD con cobros que ningún complemento de pago cubre.</div></div>';
+    }
+
+    window.FACTURAS_CLI = {
+      importar: importar, cargar: cargar, abrir: abrir, abrirLiga: abrirLiga, ligar: ligar, sinProyecto: sinProyecto, cancelar: cancelar,
+      cerrarLiga: () => { est.abierta = ''; est.liga = null; pintarTabla(); },
+      vista: v => { est.vista = v === 'todas' ? 'todas' : 'atender'; pintarConteos(); pintarTabla(); },
+      buscar: q => { est.buscar = String(q || ''); pintarTabla(); },
+      tipo: t => { est.tipo = String(t || ''); pintarTabla(); },
+      sugerencia: (uuid, i) => {
+        const f = factura(uuid), s = f && (f.sugerencias || [])[i];
+        if (!s || !est.liga || est.liga.uuid !== uuid) return;
+        Object.assign(est.liga, { proyecto: s.proyectoFolio, claves: s.etapas.slice(), montos: {} });
+        pintarTabla();
+      },
+      proyecto: (uuid, folio) => {
+        const f = factura(uuid), p = proyectoDe(folio);
+        if (!f || !est.liga || est.liga.uuid !== uuid) return;
+        Object.assign(est.liga, { proyecto: p ? p.folio : '', claves: p ? etapasQueCubren(p, f) : [], montos: {} });
+        pintarTabla();
+      },
+      etapa: (uuid, clave, si) => {
+        const L = est.liga, f = factura(uuid);
+        if (!L || L.uuid !== uuid || !f) return;
+        L.claves = L.claves.filter(c => c !== clave).concat(si ? [clave] : []);
+        const p = proyectoDe(L.proyecto), rep = p ? reparto(p, L.claves, f.total, f) : [];
+        const caja = document.getElementById('facReparto-' + idDe(uuid));
+        if (caja) caja.innerHTML = rep.length ? 'Sin montos se reparte así: ' + rep.map(x => esc(x.etapa) + ' ' + dinero(x.monto, f.moneda)).join(' + ') : 'Elige una o varias etapas.';
+      },
+      monto: (uuid, clave, valor) => { if (est.liga && est.liga.uuid === uuid) est.liga.montos[clave] = valor; },
+      motivo: (uuid, valor) => { if (est.liga && est.liga.uuid === uuid) est.liga.motivo = valor; },
+      estado: () => est, // para las pruebas
+    };
+
+    registrarModulo({
+      nombre: 'Facturas de clientes',
+      alBootstrap(d) { if (d && d.facturasCli) recibir(d.facturasCli); else pintar(); },
+      alSincronizar(r) { if (r && r.facturasCli) recibir(r.facturasCli); },
+      // El servidor vuelve a mandar la lista cuando cambia algo de lo que usa (solo si ya se cargó)
+      contexto() { return est.lista && puede() ? { facturasCli: true } : {}; },
+      alPermisos() {
+        if (!puede()) { est.lista = null; est.resultados = null; est.abierta = ''; est.liga = null; }
+        pintar();
+        if (!puede()) pintarBloque(null);
+      },
+      alVerTab(t) { if (t === 'cob' && puede() && !est.lista && !est.cargando && BOOT) cargar(); },
+      alCobranza(v) { pintarBloque(v); },
+    });
+  })();
+</script>
 </body>
 </html>
