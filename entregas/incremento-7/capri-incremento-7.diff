index 0000000..b7dfd6f
--- /dev/null
+++ b/servidor/src/index.js
@@ -0,0 +1,68 @@
+#!/usr/bin/env node
+// CAPRI — servicio de la etapa 1. Uso: node src/index.js [/etc/capri/capri.json]   (o CAPRI_CONFIG=…)
+// Ver docs/servidor-etapa-1.md y servidor/config.ejemplo.json.
+'use strict';
+const fs = require('fs');
+const path = require('path');
+
+const archivoConf = process.argv[2] || process.env.CAPRI_CONFIG || '/etc/capri/capri.json';
+const conf = Object.assign({
+  puerto: 8090, host: '127.0.0.1', origenes: [], backend: 'google', zonaHoraria: 'America/Mexico_City',
+  cuentaServicio: 'facilities@helgen.tech', trabajadores: 3, limiteMs: 120000, limiteActivadorMs: 300000,
+  sondeoSeg: 60, reconciliarMin: 10, frescuraSeg: 15, driveTtlMs: 60000, correoLimiteDiario: 1500, soloLectura: false,
+  limiteBytes: 50 * 1024 * 1024, memoriaTrabajadorMb: 768,
+}, JSON.parse(fs.readFileSync(archivoConf, 'utf8')));
+// En Docker el servicio escucha en todas las interfaces DEL CONTENEDOR (docker-compose.yml publica solo 127.0.0.1:8090 del
+// servidor); el archivo de configuración se queda con 127.0.0.1, lo seguro fuera de un contenedor.
+if (process.env.CAPRI_HOST) conf.host = process.env.CAPRI_HOST;
+if (process.env.CAPRI_PUERTO) conf.puerto = Number(process.env.CAPRI_PUERTO);
+// Zona horaria de Apps Script (appsscript.json): new Date(a, m, d) y getHours() de Code.js dependen de ella
+process.env.TZ = conf.zonaHoraria;
+
+const { crearServicio, clientIdDeCode } = require('./servicio');
+const { crearServidorHttp } = require('./http');
+const { crearRegistro } = require('./nucleo/registro');
+const { VerificadorGoogle, VerificadorTabla } = require('./nucleo/identidad');
+
+async function principal() {
+  const registro = crearRegistro(conf.registro);
+  const codigoDir = (conf.codigo && conf.codigo.dir) || path.join(__dirname, '..', '..');
+  conf.codigo = Object.assign({ dir: codigoDir }, conf.codigo);
+  const clientId = conf.clientIdGoogle || clientIdDeCode(path.join(codigoDir, 'Code.js'));
+  let conductor, identidad;
+  if (conf.backend === 'memoria') {
+    const { ConductorMemoria } = require('./backends/memoria');
+    conductor = new ConductorMemoria({});
+    const iniciales = conductor.sembrarComoArnes();
+    conf.propiedadesIniciales = Object.assign(iniciales, conf.propiedadesIniciales || {});
+    identidad = new VerificadorTabla(conf.tokensPrueba || {});
+    registro('aviso', 'backend memoria: datos de prueba en memoria (nada va a Google)');
+  } else {
+    const { crearConductorGoogle } = require('./backends/google');
+    conductor = crearConductorGoogle(Object.assign({ sujeto: conf.cuentaServicio, remitente: conf.cuentaServicio }, conf.google));
+    identidad = new VerificadorGoogle({ clientId });
+  }
+  const servicio = crearServicio(conf, { conductor, identidad, registro });
+  await servicio.iniciar();
+  const servidor = crearServidorHttp(servicio, { origenes: conf.origenes, limiteBytes: conf.limiteBytes });
+  servidor.listen(conf.puerto, conf.host, () => registro('info', 'CAPRI escuchando', { host: conf.host, puerto: conf.puerto, backend: conductor.nombre,
+    trabajadores: conf.trabajadores, soloLectura: !!conf.soloLectura }));
+
+  let apagando = false;
+  const apagar = async senal => {
+    if (apagando) return;
+    apagando = true;
+    registro('info', 'apagando (' + senal + ')');
+    servidor.close();
+    await servicio.detener();
+    registro('info', 'apagado');
+    process.exit(0);
+  };
+  process.on('SIGTERM', () => apagar('SIGTERM'));
+  process.on('SIGINT', () => apagar('SIGINT'));
+}
+
+principal().catch(e => {
+  process.stderr.write('No arrancó CAPRI: ' + (e && e.stack || e) + '\n');
+  process.exit(1);
+});
diff --git a/servidor/src/nucleo/almacen.js b/servidor/src/nucleo/almacen.js
new file mode 100644
index 0000000..8d6f042
--- /dev/null
+++ b/servidor/src/nucleo/almacen.js
@@ -0,0 +1,108 @@
+// Script Properties y CacheService en el principal.
+//  - Propiedades: un archivo JSON (incluye los secretos que hoy están en Script Properties: SESION_SECRETO,
+//    PORTAL_SECRETO, ANTHROPIC_API_KEY). Permisos 600, fuera del repositorio. Cada cambio se guarda en disco (escribir a
+//    un temporal y renombrar) antes de contestar.
+//  - Caché: en memoria con vencimiento (máx. 6 h, como CacheService). Se guarda en disco cada 30 s y al apagar, para que
+//    un reinicio no olvide las claves de idempotencia (doble clic = mismo folio) ni los bloqueos de códigos de entrada.
+'use strict';
+const fs = require('fs');
+const path = require('path');
+
+function guardarSeguro(archivo, texto) {
+  const tmp = archivo + '.tmp-' + process.pid;
+  fs.writeFileSync(tmp, texto, { mode: 0o600 });
+  const fd = fs.openSync(tmp, 'r');
+  try { fs.fsyncSync(fd); } finally { fs.closeSync(fd); }
+  fs.renameSync(tmp, archivo);
+}
+
+function leerJson(archivo, siNo) {
+  try { return JSON.parse(fs.readFileSync(archivo, 'utf8')); } catch (e) { if (e.code === 'ENOENT') return siNo; throw e; }
+}
+
+class Propiedades {
+  /** @param {string|null} archivo  null = solo en memoria (pruebas) */
+  constructor(archivo, iniciales) {
+    this.archivo = archivo;
+    this.datos = Object.assign({}, archivo ? leerJson(archivo, {}) : {}, iniciales || {});
+    Object.keys(this.datos).forEach(k => { this.datos[k] = String(this.datos[k]); });
+    if (archivo && iniciales) this.guardar();
+  }
+  leer(k) { return Object.prototype.hasOwnProperty.call(this.datos, k) ? this.datos[k] : null; }
+  todas() { return Object.assign({}, this.datos); }
+  /** cambios: {clave: texto | null (borrar)}; borrarTodo primero vacía todo. */
+  escribir(cambios, borrarTodo) {
+    if (borrarTodo) this.datos = {};
+    Object.keys(cambios || {}).forEach(k => {
+      if (cambios[k] === null || cambios[k] === undefined) delete this.datos[k]; else this.datos[k] = String(cambios[k]);
+    });
+    this.guardar();
+  }
+  guardar() {
+    if (this.archivo) guardarSeguro(this.archivo, JSON.stringify(this.datos, Object.keys(this.datos).sort(), 1));
+  }
+}
+
+class Cache {
+  constructor(archivo, opciones) {
+    this.archivo = archivo;
+    this.max = (opciones && opciones.max) || 20000;
+    this.mapa = new Map(); // clave → {v, vence}
+    if (archivo) {
+      const previo = leerJson(archivo, []);
+      const ahora = Date.now();
+      previo.forEach(([k, v, vence]) => { if (vence > ahora) this.mapa.set(k, { v, vence }); });
+    }
+    this.sucio = false;
+  }
+  leer(claves) {
+    const ahora = Date.now(), out = {};
+    claves.forEach(k => {
+      const x = this.mapa.get(k);
+      if (!x) return;
+      if (x.vence <= ahora) { this.mapa.delete(k); return; }
+      out[k] = x.v;
+    });
+    return out;
+  }
+  /** pares: [[clave, valor | null (borrar), ttlSeg]] */
+  escribir(pares) {
+    const ahora = Date.now();
+    pares.forEach(([k, v, ttl]) => {
+      this.mapa.delete(k);
+      if (v !== null && v !== undefined) this.mapa.set(k, { v: String(v), vence: ahora + Math.max(1, Number(ttl) || 600) * 1000 });
+    });
+    // Como CacheService, lo más viejo se puede perder: aquí se recorta en orden de escritura
+    while (this.mapa.size > this.max) this.mapa.delete(this.mapa.keys().next().value);
+    this.sucio = true;
+  }
+  /** Borra las claves que empiezan con alguno de los prefijos (p. ej. "R_" para releer las hojas editadas a mano). */
+  borrarPrefijos(prefijos) {
+    for (const k of [...this.mapa.keys()]) if (prefijos.some(p => k.startsWith(p))) this.mapa.delete(k);
+    this.sucio = true;
+  }
+  guardar() {
+    if (!this.archivo || !this.sucio) return;
+    const ahora = Date.now(), filas = [];
+    this.mapa.forEach((x, k) => { if (x.vence > ahora) filas.push([k, x.v, x.vence]); });
+    guardarSeguro(this.archivo, JSON.stringify(filas));
+    this.sucio = false;
+  }
+  get tamano() { return this.mapa.size; }
+}
+
+/** Estado propio del servicio (activadores instalados, cuota de correo del día). */
+class Estado {
+  constructor(archivo) {
+    this.archivo = archivo;
+    this.datos = Object.assign({ activadores: [], correo: { dia: '', destinatarios: 0 } }, archivo ? leerJson(archivo, {}) : {});
+  }
+  guardar() { if (this.archivo) guardarSeguro(this.archivo, JSON.stringify(this.datos, null, 1)); }
+}
+
+function asegurarCarpeta(dir) {
+  fs.mkdirSync(dir, { recursive: true, mode: 0o700 });
+  return dir;
+}
+
+module.exports = { Propiedades, Cache, Estado, guardarSeguro, leerJson, asegurarCarpeta, path };
diff --git a/servidor/src/nucleo/candado.js b/servidor/src/nucleo/candado.js
new file mode 100644
index 0000000..a3c7852
--- /dev/null
+++ b/servidor/src/nucleo/candado.js
@@ -0,0 +1,84 @@
+// Candado de script (el de LockService.getScriptLock) en el principal: uno solo para todo el servicio, en orden de
+// llegada. Además de Code.js lo usan el principal para confirmar lo escrito fuera del candado y para cambiar la copia
+// canónica de un libro editado a mano: así la copia canónica solo cambia con el candado tomado y quien lo tiene ve
+// exactamente lo que está en Sheets (salvo ediciones a mano de los últimos segundos; ver alEntregar).
+'use strict';
+
+class Candado {
+  constructor(opciones) {
+    const o = opciones || {};
+    this.dueno = null;
+    this.desde = 0;
+    this.cola = [];
+    this.alEntregar = o.alEntregar || null; // async: p. ej. revisar si alguien editó a mano antes de entregar
+    this.entregando = false;
+    this.registro = o.registro || (() => {});
+  }
+
+  libre() { return !this.dueno && !this.entregando && !this.cola.some(p => !p.cancelada); }
+
+  /** Promesa: true si se obtuvo antes de ms (null = esperar lo que haga falta), false si no. */
+  tomar(dueno, ms) {
+    return new Promise(resolve => {
+      if (ms === 0 && !this.libre()) { resolve(false); return; }
+      const pet = { dueno, resolve, cancelada: false, timer: null, llego: Date.now() };
+      if (ms != null && ms > 0) {
+        pet.timer = setTimeout(() => {
+          pet.cancelada = true;
+          const i = this.cola.indexOf(pet);
+          if (i !== -1) { this.cola.splice(i, 1); resolve(false); }
+        }, ms);
+      }
+      this.cola.push(pet);
+      this.siguiente();
+    });
+  }
+
+  async siguiente() {
+    if (this.dueno || this.entregando) return;
+    let pet;
+    while ((pet = this.cola.shift()) && pet.cancelada) { /* se brinca */ }
+    if (!pet) return;
+    if (pet.timer) clearTimeout(pet.timer);
+    this.entregando = true;
+    this.dueno = pet.dueno;
+    this.desde = Date.now();
+    if (this.alEntregar) {
+      try { await this.alEntregar(pet.dueno); } catch (e) { this.registro('aviso', 'Revisión antes de entregar el candado: ' + e.message); }
+    }
+    this.entregando = false;
+    pet.resolve(true);
+  }
+
+  soltar(dueno) {
+    if (this.dueno !== dueno) return false;
+    this.dueno = null;
+    this.desde = 0;
+    setImmediate(() => this.siguiente());
+    return true;
+  }
+
+  /**
+   * Un trabajador murió (corte por tiempo o error): se quitan de la cola sus peticiones pendientes y, si tenía el
+   * candado, se suelta. Sin esto, una petición encolada se entregaría después a un dueño muerto y nadie lo soltaría.
+   */
+  cancelar(dueno) {
+    this.cola.forEach(p => {
+      if (p.dueno === dueno && !p.cancelada) { p.cancelada = true; if (p.timer) clearTimeout(p.timer); p.resolve(false); }
+    });
+    this.cola = this.cola.filter(p => !p.cancelada);
+    return this.soltar(dueno);
+  }
+
+  /** Corre f() con el candado (para el principal). */
+  async con(dueno, f) {
+    await this.tomar(dueno, null);
+    try { return await f(); } finally { this.soltar(dueno); }
+  }
+
+  estado() {
+    return { dueno: this.dueno, msTomado: this.dueno ? Date.now() - this.desde : 0, enCola: this.cola.filter(p => !p.cancelada).length };
+  }
+}
+
+module.exports = { Candado };
diff --git a/servidor/src/nucleo/espejo-central.js b/servidor/src/nucleo/espejo-central.js
new file mode 100644
index 0000000..f934f7b
--- /dev/null
+++ b/servidor/src/nucleo/espejo-central.js
@@ -0,0 +1,201 @@
+// Copia canónica de los libros en el principal.
+//
+//  abrir(id)       la primera vez se carga de Google (una llamada) y se registra para vigilarla.
+//  confirmar(...)  con el candado tomado: por libro, en orden, una batchUpdate atómica + lectura de regreso de las hojas
+//                  tocadas (lo que Sheets guardó de verdad). Si todos los libros llegaron, se aplican propiedades y caché
+//                  y se manda la copia nueva a los demás trabajadores. Si uno falla, ese libro se vuelve a leer de Google,
+//                  los que siguen no se mandan y la llamada lanza error (doPost contesta {ok:false}).
+//  sondear()       cada minuto: versión de cada libro en Drive; si alguien lo editó a mano, se relee y se reemplaza (con
+//                  el candado), se suben las versiones de sus colecciones y se borran las marcas R_ del caché para que la
+//                  siguiente consulta de los navegadores lo vea.
+//  reconciliar()   cada 10 min: relee todo y compara; si algo difiere (una fórmula que se recalculó, como el tipo de
+//                  cambio, o una edición que el sondeo no vio) se reemplaza y queda en el registro como "deriva".
+'use strict';
+const crypto = require('crypto');
+const M = require('../espejo/modelo');
+
+// Lo que define "el libro cambió": valores, fórmulas y estructura (no el texto visible ni lo que el espejo guarda de formato)
+const FUERA_DE_HUELLA = new Set(['mostrar', 'texto', 'cargadas']);
+const huella = libro => crypto.createHash('sha1').update(JSON.stringify(libro.hojas, (k, v) => (FUERA_DE_HUELLA.has(k) ? undefined : v))).digest('hex');
+
+class EspejoCentral {
+  /**
+   * @param {object} o
+   *   conductor  backend (memoria o google): cargarLibro, crearLibro, confirmar, versionLibro
+   *   candado    Candado
+   *   difundir   (libros, exceptoTrabajador) => void
+   *   alCambioExterno  (libroId) => void   (sube versiones de colecciones, borra marcas R_)
+   *   registro   (nivel, texto, extra) => void
+   */
+  constructor(o) {
+    Object.assign(this, { conductor: o.conductor, candado: o.candado, difundir: o.difundir || (() => {}),
+      alCambioExterno: o.alCambioExterno || (() => {}), registro: o.registro || (() => {}) });
+    this.libros = new Map();    // id → {libro, version, huella, cargado}
+    this.cargando = new Map();  // id → Promise
+    this.ultimoSondeo = 0;
+    this.soloLectura = !!o.soloLectura;
+    this.metricas = { confirmaciones: 0, fallas: 0, recargas: 0, derivas: 0, msGoogle: 0 };
+  }
+
+  async abrir(id) {
+    const x = this.libros.get(id);
+    if (x) return x.libro;
+    if (!this.cargando.has(id)) {
+      this.cargando.set(id, (async () => {
+        try {
+          const libro = await this.conductor.cargarLibro(id);
+          libro.rev = 1;
+          this.libros.set(id, { libro, version: libro.version, huella: null, cargado: Date.now() });
+          return libro;
+        } finally {
+          this.cargando.delete(id);
+        }
+      })());
+    }
+    return this.cargando.get(id);
+  }
+
+  async crear(nombre) {
+    if (this.soloLectura) throw new Error('Servidor en modo solo lectura: no se crean libros.');
+    const libro = await this.conductor.crearLibro(nombre);
+    libro.rev = 1;
+    this.libros.set(libro.id, { libro, version: libro.version, huella: null, cargado: Date.now() });
+    return libro;
+  }
+
+  /**
+   * Confirma lo que mandó un trabajador. Hay que llamarla con el candado tomado (la llama quien lo tiene).
+   * @returns {libros: [parche]} lo que cambió de cada libro (sus hojas tocadas tal como quedaron en Sheets)
+   */
+  async confirmar(libros, opciones) {
+    const o = opciones || {};
+    const nuevos = [];
+    for (const { id, ops } of libros) {
+      if (!ops || !ops.length) continue;
+      await this.abrir(id);
+      const actual = this.libros.get(id);
+      if (this.soloLectura) {
+        // Corrida de sombra: lo que se habría escrito queda en el registro y no sale del servidor
+        this.registro('aviso', 'solo lectura: no se escribió en ' + id, { ops: ops.map(x => x.op + (x.hoja != null ? '@' + x.hoja : '')) });
+        nuevos.push(actual.libro);
+        continue;
+      }
+      const t0 = Date.now();
+      try {
+        const libro = await this.conductor.confirmar(actual.libro, ops);
+        this.metricas.msGoogle += Date.now() - t0;
+        this.metricas.confirmaciones++;
+        libro.rev = (actual.libro.rev || 0) + 1;
+        const tocadas = new Set(), borradas = [];
+        ops.forEach(op => {
+          if (op.op === 'borrarHoja') { borradas.push(op.hoja); tocadas.delete(op.hoja); } else if (op.op === 'nuevaHoja') tocadas.add(op.id);
+          else if (op.hoja != null) tocadas.add(op.hoja);
+        });
+        // La versión de Drive después de nuestro cambio: se pide aparte (sin esperar) para no confundirla con una edición
+        // a mano; si mientras tanto alguien editó, la reconciliación lo corrige. La huella se calcula hasta que se necesite.
+        this.libros.set(id, { libro, version: actual.version, huella: null, cargado: Date.now(), pidiendoVersion: true });
+        this.anotarVersion(id);
+        nuevos.push(M.parcheDe(libro, actual.libro.rev || 0, tocadas, borradas));
+      } catch (e) {
+        this.metricas.fallas++;
+        this.registro('error', 'No se confirmó el libro ' + id + ': ' + e.message, { ops: ops.length });
+        // Lo que haya en Google manda: se vuelve a leer (si tampoco se puede, se olvida y se cargará al pedirlo)
+        let recargado = null;
+        try { recargado = await this.conductor.cargarLibro(id); } catch (e2) { this.libros.delete(id); }
+        if (recargado) {
+          recargado.rev = (actual.libro.rev || 0) + 1;
+          this.libros.set(id, { libro: recargado, version: recargado.version, huella: null, cargado: Date.now() });
+        }
+        const confirmados = nuevos.map(l => l.id);
+        if (nuevos.length) this.difundir(nuevos, o.trabajador);
+        this.difundir(recargado ? [recargado] : [], o.trabajador, recargado ? [] : [id]);
+        const err = new Error('No se pudo guardar en Google Sheets (' + (o.nombreDe ? o.nombreDe(id) : id) + '): ' + resumenError(e) +
+          (confirmados.length ? ' Lo de ' + confirmados.length + ' libro(s) anterior(es) sí se guardó.' : ' No se guardó nada de esta operación.') +
+          ' Revisa antes de repetir.');
+        err.codigo = 'GUARDAR';
+        throw err;
+      }
+    }
+    if (nuevos.length) this.difundir(nuevos, o.trabajador);
+    return { libros: nuevos };
+  }
+
+  async anotarVersion(id) {
+    try {
+      const v = await this.conductor.versionLibro(id);
+      const x = this.libros.get(id);
+      if (x) { x.version = v; x.pidiendoVersion = false; }
+    } catch (e) {
+      this.registro('aviso', 'No se leyó la versión de ' + id + ' después de guardar: ' + e.message);
+    }
+  }
+
+  /** Revisa en Drive si algún libro cambió fuera del servicio (a mano). Devuelve los ids que se releyeron. */
+  async sondear() {
+    this.ultimoSondeo = Date.now();
+    const ids = [...this.libros.keys()];
+    const versiones = await Promise.all(ids.map(id => this.conductor.versionLibro(id).catch(e => {
+      this.registro('aviso', 'Sondeo de ' + id + ': ' + e.message);
+      return null;
+    })));
+    const cambiados = ids.filter((id, i) => {
+      const x = this.libros.get(id);
+      return versiones[i] != null && x && !x.pidiendoVersion && String(versiones[i]) !== String(x.version);
+    });
+    for (const id of cambiados) await this.recargar(id, 'edición fuera del servicio');
+    return cambiados;
+  }
+
+  /** Relee un libro de Google y reemplaza la copia canónica con el candado tomado (nadie está a medio escribir). */
+  async recargar(id, motivo, sinCandado) {
+    const inicio = Date.now();
+    const libro = await this.conductor.cargarLibro(id);
+    const cambiar = async () => {
+      const antes = this.libros.get(id);
+      // Si mientras se leía se confirmó algo en este libro, lo leído puede ser más viejo: se deja para el siguiente sondeo
+      if (antes && antes.cargado > inicio) return false;
+      const h = huella(libro);
+      const hAntes = antes ? (antes.huella || huella(antes.libro)) : null;
+      libro.rev = (antes ? antes.libro.rev || 0 : 0) + 1;
+      this.libros.set(id, { libro, version: libro.version, huella: h, cargado: Date.now() });
+      this.metricas.recargas++;
+      if (antes && hAntes !== h) {
+        this.registro('info', 'libro releído: ' + id + ' (' + motivo + ')');
+        this.difundir([libro], null);
+        this.alCambioExterno(id);
+        return true;
+      }
+      return false;
+    };
+    return sinCandado ? cambiar() : this.candado.con('principal:recarga', cambiar);
+  }
+
+  /** Relee todos y reemplaza los que difieren (fórmulas recalculadas, ediciones que el sondeo no vio). */
+  async reconciliar() {
+    const ids = [...this.libros.keys()];
+    let derivas = 0;
+    for (const id of ids) {
+      try {
+        if (await this.recargar(id, 'reconciliación')) { derivas++; this.metricas.derivas++; }
+      } catch (e) {
+        this.registro('aviso', 'Reconciliación de ' + id + ': ' + e.message);
+      }
+    }
+    return derivas;
+  }
+
+  estado() {
+    const ahora = Date.now();
+    return [...this.libros].map(([id, x]) => ({ id, titulo: x.libro.titulo, locale: x.libro.locale, zona: x.libro.zona, hojas: x.libro.hojas.length,
+      celdas: x.libro.hojas.reduce((s, h) => s + h.valores.reduce((t, f) => t + (f ? f.length : 0), 0), 0),
+      version: x.version, segDesdeCarga: Math.round((ahora - x.cargado) / 1000) }));
+  }
+}
+
+function resumenError(e) {
+  const r = e && e.response;
+  if (r && r.data && r.data.error) return (r.data.error.status || r.status) + ' ' + String(r.data.error.message || '').slice(0, 200);
+  return String(e && e.message || e).slice(0, 300);
+}
+
+module.exports = { EspejoCentral, huella, resumenError };
