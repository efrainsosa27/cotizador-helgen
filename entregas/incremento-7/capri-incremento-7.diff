+const FORMATO_CELDA = { auto: null, texto: { tipo: 'TEXT', patron: '@' }, fecha: { tipo: 'DATE_TIME', patron: 'dd/MM/yyyy HH:mm' } };
+
+module.exports = { CASOS, FORMATO_CELDA };
