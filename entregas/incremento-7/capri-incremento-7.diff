+    if (t > MAX_HORAS_DIA) throw new Error('El ' + DIAS_SEMANA_HORAS[i] + ' suma ' + textoHoras(t) + ' h: máximo ' + MAX_HORAS_DIA + ' h al día entre todos tus proyectos.');
