+      estado = HORAS_ENVIADA;
+      enviada = igual && e.estado === HORAS_ENVIADA ? e.enviada || null : null;
+    } else if (!e) {
+      estado = HORAS_BORRADOR;
+    } else if (igual) {
+      estado = e.estado; motivo = e.motivo || ''; enviada = e.enviada || '';
+    } else if (e.estado === HORAS_DEVUELTA) {
