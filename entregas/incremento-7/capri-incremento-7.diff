+
+(async () => {
+  // Datos: un proyecto MXN y uno USD (aceptada en dólares)
+  const p1o = ok('ana', 'crearProyecto', { nombre: 'Planta Norte', ubicacion: 'Qro', cliente: { nombre: 'Cliente Uno', empresa: 'SA' }, idSolicitud: 'p1' });
