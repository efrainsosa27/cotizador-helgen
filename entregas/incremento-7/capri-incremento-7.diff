index 0000000..975524a
--- /dev/null
+++ b/servidor/src/nucleo/servicios.js
@@ -0,0 +1,216 @@
+// Servicios del principal que atienden al puente: Drive (con memoria de corto plazo), UrlFetch (con las desviaciones
+// de tokeninfo y googleapis.com), correo (cuota diaria), PDF y activadores.
+'use strict';
+
+/** Drive con memoria de unos segundos para lo que se busca en cada guardado (carpeta del año, del proyecto…). */
+class ServicioDrive {
+  constructor(o) {
+    this.c = o.conductor.drive;
+    this.ttl = o.ttlMs == null ? 60000 : o.ttlMs;
+    this.soloLectura = !!o.soloLectura;
+    this.metas = new Map();
+    this.hijosCache = new Map();
+  }
+  recordar(m) { if (m && m.id) this.metas.set(m.id, { m, vence: Date.now() + this.ttl }); return m; }
+  olvidarHijos(padre) { for (const k of [...this.hijosCache.keys()]) if (k.startsWith(padre + '|')) this.hijosCache.delete(k); }
+  noEscribir(que) { if (this.soloLectura) throw new Error('Servidor en modo solo lectura: no se ' + que + ' en Drive.'); }
+  async obtener(d) {
+    const x = this.metas.get(d.id);
+    if (x && x.vence > Date.now()) return x.m;
+    return this.recordar(await this.c.obtener(d));
+  }
+  async raiz() {
+    if (this.raizId) return this.obtener({ id: this.raizId });
+    const m = this.recordar(await this.c.raiz({}));
+    this.raizId = m.id;
+    return m;
+  }
+  async hijos(d) {
+    const k = d.padre + '|' + (d.carpetas ? 'c' : 'a') + '|' + (d.nombre == null ? '*' : d.nombre);
+    const x = this.hijosCache.get(k);
+    if (x && x.vence > Date.now()) return x.lista;
+    const lista = await this.c.hijos(d);
+    lista.forEach(m => this.recordar(m));
+    this.hijosCache.set(k, { lista, vence: Date.now() + this.ttl });
+    return lista;
+  }
+  async buscar(d) { return this.c.buscar(d); }
+  async crearCarpeta(d) {
+    this.noEscribir('crean carpetas');
+    const padre = d.padre || (await this.raiz()).id;
+    const m = await this.c.crearCarpeta({ padre, nombre: d.nombre });
+    this.olvidarHijos(padre);
+    return this.recordar(m);
+  }
+  async crearArchivo(d) {
+    this.noEscribir('suben archivos');
+    const m = await this.c.crearArchivo(d);
+    this.olvidarHijos(d.padre);
+    return this.recordar(m);
+  }
+  async cambio(f, d) {
+    const antes = this.metas.get(d.id);
+    const m = await f(d);
+    (antes && antes.m.padres || []).concat(m.padres || []).forEach(p => this.olvidarHijos(p));
+    return this.recordar(m);
+  }
+  async renombrar(d) { this.noEscribir('renombran archivos'); return this.cambio(x => this.c.renombrar(x), d); }
+  async mover(d) { this.noEscribir('mueven archivos'); return this.cambio(x => this.c.mover(x), d); }
+  async papelera(d) { this.noEscribir('borran archivos'); return this.cambio(x => this.c.papelera(x), d); }
+  async personas(d) { return this.c.personas(d); }
+  async contenido(d) { return this.c.contenido(d); }
+}
+
+/**
+ * UrlFetchApp.fetch del lado del principal:
+ *  - tokeninfo → verificación local (identidad.js)
+ *  - *.googleapis.com con el token marcador de ScriptApp.getOAuthToken() → el conductor pone la credencial real
+ *  - lo demás (centro de mando, API de Claude) → red normal
+ */
+function crearSalida(o) {
+  const { identidad, conductor, marcaToken, soloLectura, registro } = o;
+  const json = (codigo, x) => ({ codigo, cabeceras: { 'content-type': 'application/json; charset=utf-8' }, cuerpo: Buffer.from(JSON.stringify(x)) });
+  return async function salida(p) {
+    let url;
+    try { url = new URL(p.url); } catch (e) { throw new Error('Dirección no válida: ' + p.url); }
+    if (url.hostname === 'oauth2.googleapis.com' && url.pathname === '/tokeninfo') {
+      const r = await identidad.verificar(url.searchParams.get('id_token'));
+      return r.codigo === 200 ? json(200, r.claims) : json(400, { error: 'invalid_token', error_description: r.error });
+    }
+    const auth = Object.keys(p.cabeceras || {}).find(k => k.toLowerCase() === 'authorization');
+    if (/(^|\.)googleapis\.com$/.test(url.hostname) && auth && p.cabeceras[auth] === 'Bearer ' + marcaToken) {
+      if (soloLectura && p.metodo !== 'GET') {
+        registro('aviso', 'solo lectura: no se mandó ' + p.metodo + ' ' + url.pathname);
+        return { codigo: 204, cabeceras: {}, cuerpo: Buffer.alloc(0) };
+      }
+      return conductor.fetchGoogle(p);
+    }
+    if (soloLectura) {
+      registro('aviso', 'solo lectura: llamada externa bloqueada ' + url.hostname);
+      return json(503, { ok: false, error: 'Servidor en modo solo lectura (corrida de sombra).' });
+    }
+    return conductor.fetch(p);
+  };
+}
+
+/** Correo como la cuenta del servicio, con la misma idea de cuota diaria que MailApp (destinatarios por día). */
+class ServicioCorreo {
+  constructor(o) {
+    Object.assign(this, { conductor: o.conductor, estado: o.estado, limite: o.limiteDiario || 1500, zona: o.zona || 'America/Mexico_City',
+      soloLectura: !!o.soloLectura, registro: o.registro || (() => {}) });
+    this.enviados = 0;
+  }
+  hoy() { return new Intl.DateTimeFormat('en-CA', { timeZone: this.zona }).format(new Date()); }
+  usados() {
+    const c = this.estado.datos.correo;
+    if (c.dia !== this.hoy()) { c.dia = this.hoy(); c.destinatarios = 0; }
+    return c.destinatarios;
+  }
+  cuota() { return Math.max(0, this.limite - this.usados()); }
+  async enviar(m) {
+    const n = [m.para, m.cc, m.cco].filter(Boolean).join(',').split(',').filter(x => x.trim()).length;
+    if (this.soloLectura) { this.registro('aviso', 'solo lectura: correo no enviado', { asunto: m.asunto, n }); return true; }
+    if (this.cuota() < n) throw new Error('Service invoked too many times for one day: email.');
+    await this.conductor.enviarCorreo(m);
+    this.estado.datos.correo.destinatarios = this.usados() + n;
+    this.estado.guardar();
+    this.enviados++;
+    return true;
+  }
+}
+
+/** HTML → PDF con Chromium (puppeteer-core). JavaScript apagado y sin red: solo el HTML y sus imágenes data:. */
+class MotorPdf {
+  constructor(o) {
+    const op = o || {};
+    this.ejecutable = op.ejecutable;
+    this.formato = op.formato || 'Letter';
+    this.margen = op.margen || { top: '10mm', bottom: '10mm', left: '10mm', right: '10mm' };
+    this.max = op.concurrencia || 2;
+    this.lanzar = op.lanzar || null; // pruebas: función que devuelve un navegador falso
+    this.args = op.args || ['--no-sandbox', '--disable-dev-shm-usage', '--disable-gpu', '--font-render-hinting=none'];
+    this.activos = 0;
+    this.espera = [];
+    this.nav = null;
+    this.metricas = { pdfs: 0, ms: 0, reinicios: 0 };
+  }
+  async navegador() {
+    if (!this.nav) {
+      this.nav = (async () => {
+        // chrome-headless-shell (el de la imagen) va en modo "shell" (puppeteer ≥ 22); un Chromium completo, en headless normal
+        const headless = /headless-shell/.test(String(this.ejecutable || '')) ? 'shell' : true;
+        const lanzar = this.lanzar || (async () => require('puppeteer-core').launch({ executablePath: this.ejecutable, headless, args: this.args }));
+        const n = await lanzar();
+        if (n.on) n.on('disconnected', () => { this.nav = null; this.metricas.reinicios++; });
+        return n;
+      })().catch(e => { this.nav = null; throw new Error('No se pudo abrir Chromium para el PDF: ' + e.message); });
+    }
+    return this.nav;
+  }
+  async turno() {
+    if (this.activos < this.max) { this.activos++; return; }
+    await new Promise(r => this.espera.push(r));
+    this.activos++;
+  }
+  libre() { this.activos--; const r = this.espera.shift(); if (r) r(); }
+  async html(html) {
+    await this.turno();
+    const t0 = Date.now();
+    let pagina = null;
+    try {
+      const nav = await this.navegador();
+      pagina = await nav.newPage();
+      await pagina.setJavaScriptEnabled(false);
+      await pagina.setRequestInterception(true);
+      pagina.on('request', r => (/^(data:|about:)/.test(r.url()) ? r.continue() : r.abort()));
+      await pagina.setContent(String(html), { waitUntil: 'load', timeout: 20000 });
+      // Sin colores de fondo, como el conversor de Google (el HTML ya está hecho para eso, §6.3)
+      const pdf = await pagina.pdf({ format: this.formato, printBackground: false, margin: this.margen, preferCSSPageSize: true, timeout: 30000 });
+      this.metricas.pdfs++;
+      this.metricas.ms += Date.now() - t0;
+      return Buffer.from(pdf);
+    } finally {
+      if (pagina) await pagina.close().catch(() => {});
+      this.libre();
+    }
+  }
+  async cerrar() { if (this.nav) { const n = await this.nav.catch(() => null); this.nav = null; if (n) await n.close().catch(() => {}); } }
+}
+
+/** Activadores de tiempo (ScriptApp.newTrigger): se guardan en estado.json y los corre el servicio. */
+class Activadores {
+  constructor(o) {
+    Object.assign(this, { estado: o.estado, ejecutar: o.ejecutar, registro: o.registro || (() => {}), habilitados: o.habilitados !== false });
+    this.timers = new Map();
+    this.corriendo = new Set();
+  }
+  listar() { return this.estado.datos.activadores.slice(); }
+  crear(d) {
+    if (!d.cadaMinutos || d.cadaMinutos < 1) throw new Error('Activador sin intervalo.');
+    const t = { id: 'act-' + Date.now().toString(36) + Math.random().toString(36).slice(2, 6), funcion: d.funcion, cadaMinutos: d.cadaMinutos };
+    this.estado.datos.activadores.push(t);
+    this.estado.guardar();
+    this.programar(t);
+    return t;
+  }
+  borrar(d) {
+    this.estado.datos.activadores = this.estado.datos.activadores.filter(t => t.id !== d.id);
+    this.estado.guardar();
+    const x = this.timers.get(d.id);
+    if (x) { clearInterval(x); this.timers.delete(d.id); }
+    return true;
+  }
+  programar(t) {
+    if (!this.habilitados || this.timers.has(t.id)) return;
+    this.timers.set(t.id, setInterval(() => this.correr(t.funcion), t.cadaMinutos * 60000));
+  }
+  iniciar() { this.listar().forEach(t => this.programar(t)); }
+  async correr(funcion) {
+    if (this.corriendo.has(funcion)) { this.registro('aviso', 'activador ' + funcion + ': la corrida anterior sigue; se salta'); return null; }
+    this.corriendo.add(funcion);
+    try { return await this.ejecutar(funcion); } finally { this.corriendo.delete(funcion); }
+  }
+  detener() { this.timers.forEach(x => clearInterval(x)); this.timers.clear(); }
+}
+
+module.exports = { ServicioDrive, crearSalida, ServicioCorreo, MotorPdf, Activadores };
diff --git a/servidor/src/pool.js b/servidor/src/pool.js
new file mode 100644
index 0000000..a54105b
--- /dev/null
+++ b/servidor/src/pool.js
@@ -0,0 +1,179 @@
+// Grupo de trabajadores. Cada petición va a un trabajador libre; si no hay, espera en la cola.
+//  - Escrituras (funciones de CAMBIOS_API) y lecturas comparten trabajadores, pero siempre queda al menos uno para
+//    lecturas: tres guardados esperando el candado nunca dejan sin atender un clic de consulta.
+//  - Un trabajo que pasa su límite de tiempo se corta: se termina el trabajador (se crea otro), se espera a que acabe lo
+//    que el principal estuviera confirmando por él y se suelta su candado. Lo que no había confirmado no llega a Sheets.
+'use strict';
+const { Worker, MessageChannel } = require('worker_threads');
+const path = require('path');
+const { PuenteServidor } = require('./puente');
+
+class Pool {
+  /**
+   * @param {object} o
+   *   n             trabajadores (≥ 2)
+   *   confTrabajador  lo que necesita cada trabajador (archivos de Code.js, plantillas, zona…)
+   *   atender       async (tipo, datos, trabajador) → respuesta del puente
+   *   alMorir       async (trabajador) → limpiar (soltar candado…)
+   *   registro      (nivel, texto, extra)
+   *   limiteMs      por petición; limiteActivadorMs para activadores
+   */
+  constructor(o) {
+    Object.assign(this, { n: Math.max(2, o.n || 3), confTrabajador: o.confTrabajador, atender: o.atender, alMorir: o.alMorir || (async () => {}),
+      registro: o.registro || (() => {}), limiteMs: o.limiteMs || 120000, limiteActivadorMs: o.limiteActivadorMs || 300000 });
+    this.trabajadores = [];
+    this.cola = [];
+    this.siguienteId = 1;
+    this.cambiosApi = new Set();
+    this.publicas = new Set();
+    this.cerrando = false;
+    this.metricas = { atendidos: 0, cortados: 0, reinicios: 0 };
+  }
+
+  async iniciar() {
+    await Promise.all(Array.from({ length: this.n }, (_, i) => this.crear(i + 1)));
+    this.vigia = setInterval(() => this.vigilar(), 1000);
+    this.vigia.unref();
+  }
+
+  crear(numero) {
+    return new Promise((resolve, reject) => {
+      const canal = new MessageChannel();
+      const memoria = new SharedArrayBuffer(4);
+      const worker = new Worker(path.join(__dirname, 'trabajador.js'), {
+        workerData: { conf: Object.assign({}, this.confTrabajador, { numero }), puerto: canal.port2, memoria },
+        transferList: [canal.port2],
+        resourceLimits: this.confTrabajador.memoriaMb ? { maxOldGenerationSizeMb: this.confTrabajador.memoriaMb } : undefined,
+      });
+      const t = { numero, worker, trabajo: null, listo: false, confirmando: null };
+      t.puente = new PuenteServidor(canal.port1, memoria, (tipo, datos) => this.atenderDe(t, tipo, datos));
+      worker.on('message', m => {
+        if (m.tipo === 'listo') {
+          t.listo = true;
+          t.msCarga = m.msCarga;
+          t.memoria = m.memoria;
+          (m.cambiosApi || []).forEach(f => this.cambiosApi.add(f));
+          (m.publicas || []).forEach(f => this.publicas.add(f));
+          resolve(t);
+          this.despachar();
+        } else if (m.tipo === 'hecho') {
+          this.terminar(t, m);
+          if (Math.random() < 0.05) t.worker.postMessage({ tipo: 'memoria' });
+        } else if (m.tipo === 'memoria') {
+          t.memoria = m.memoria;
+        }
+      });
+      worker.on('error', e => { this.registro('error', 'trabajador ' + numero + ': ' + e.message); if (!t.listo) reject(e); });
+      worker.on('exit', codigo => this.alSalir(t, codigo));
+      const i = this.trabajadores.findIndex(x => x.numero === numero);
+      if (i === -1) this.trabajadores.push(t); else this.trabajadores[i] = t;
+    });
+  }
+
+  /** El principal atiende lo que pide un trabajador; anota la confirmación en curso (para cortes limpios). */
+  atenderDe(t, tipo, datos) {
+    const p = this.atender(tipo, datos, t);
+    if (tipo === 'tx.confirmar') {
+      t.confirmando = p.catch(() => {});
+      p.finally(() => { if (t.confirmando) t.confirmando = null; }).catch(() => {});
+    }
+    return p;
+  }
+
+  dueno(t) { return 'w' + t.numero + '#' + (t.trabajo ? t.trabajo.id : 0); }
+
+  /** {cuerpo} (doPost) o {funcion, args} (activador). clase: lectura | escritura | activador. */
+  ejecutar(trabajo) {
+    if (this.cerrando) return Promise.resolve({ texto: JSON.stringify({ ok: false, error: 'El servidor se está reiniciando. Intenta en unos segundos.' }), metricas: {} });
+    return new Promise((resolve, reject) => {
+      this.cola.push(Object.assign({ id: this.siguienteId++, llego: Date.now(), resolve, reject }, trabajo));
+      this.despachar();
+    });
+  }
+
+  despachar() {
+    for (;;) {
+      const libres = this.trabajadores.filter(t => t.listo && !t.trabajo);
+      if (!libres.length || !this.cola.length) return;
+      const ocupadosEscribiendo = this.trabajadores.filter(t => t.trabajo && t.trabajo.clase !== 'lectura').length;
+      // Siempre queda un trabajador para lecturas
+      const k = this.cola.findIndex(x => x.clase === 'lectura' || ocupadosEscribiendo < this.n - 1);
+      if (k === -1) return;
+      const trabajo = this.cola.splice(k, 1)[0];
+      // El que lleva más tiempo sin trabajar: reparte la carga (y cada trabajador ve lo que confirmaron los otros)
+      const t = libres.reduce((a, b) => ((a.ultimoUso || 0) <= (b.ultimoUso || 0) ? a : b));
+      t.ultimoUso = Date.now() + Math.random();
+      t.trabajo = trabajo;
+      trabajo.inicio = Date.now();
+      trabajo.limite = trabajo.inicio + (trabajo.clase === 'activador' ? this.limiteActivadorMs : this.limiteMs);
+      t.worker.postMessage({ tipo: 'trabajo', id: trabajo.id, cuerpo: trabajo.cuerpo, funcion: trabajo.funcion, args: trabajo.args });
+    }
+  }
+
+  terminar(t, m) {
+    const trabajo = t.trabajo;
+    t.trabajo = null;
+    this.metricas.atendidos++;
+    if (trabajo && trabajo.id === m.id) {
+      trabajo.resolve({ texto: m.texto, metricas: Object.assign({ msCola: trabajo.inicio - trabajo.llego, trabajador: t.numero }, m.metricas) });
+    }
+    this.despachar();
+  }
+
+  vigilar() {
+    const ahora = Date.now();
+    this.trabajadores.forEach(t => {
+      if (t.trabajo && !t.cortando && ahora > t.trabajo.limite) {
+        t.cortando = true;
+        this.metricas.cortados++;
+        this.registro('error', 'trabajo cortado por tiempo', { trabajador: t.numero, funcion: t.trabajo.funcion, ms: ahora - t.trabajo.inicio });
+        t.worker.terminate();
+      }
+    });
+  }
+
+  async alSalir(t, codigo) {
+    const trabajo = t.trabajo;
+    const dueno = this.dueno(t);
+    t.listo = false;
+    t.trabajo = null;
+    t.puente.cerrar();
+    if (t.confirmando) await t.confirmando;
+    try { await this.alMorir(t, dueno); } catch (e) { this.registro('error', 'limpieza del trabajador ' + t.numero + ': ' + e.message); }
+    if (trabajo) {
+      trabajo.resolve({ texto: JSON.stringify({ ok: false, codigo: 'TIEMPO', error: t.cortando
+        ? 'La operación tardó demasiado y se detuvo. Lo que no alcanzó a guardarse no se guardó; revisa antes de repetir.'
+        : 'Error interno del servidor. Revisa antes de repetir.' }), metricas: { msCola: trabajo.inicio - trabajo.llego, trabajador: t.numero } });
+    }
+    if (!this.cerrando) {
+      this.metricas.reinicios++;
+      this.registro('aviso', 'trabajador ' + t.numero + ' terminó (' + codigo + '); se crea otro');
+      this.crear(t.numero).catch(e => this.registro('error', 'no se pudo crear el trabajador ' + t.numero + ': ' + e.message));
+    }
+  }
+
+  /** Copias nuevas de libros a todos los trabajadores (menos el que las confirmó, que ya las tiene). */
+  difundir(libros, excepto, olvidar) {
+    this.trabajadores.forEach(t => {
+      if (!t.listo || t.numero === excepto) return;
+      if (libros && libros.length) t.puente.avisar({ tipo: 'libros', libros });
+      if (olvidar && olvidar.length) t.puente.avisar({ tipo: 'olvidar', ids: olvidar });
+    });
+  }
+
+  estado() {
+    return { trabajadores: this.trabajadores.map(t => ({ numero: t.numero, listo: t.listo, ocupado: t.trabajo ? t.trabajo.funcion || 'doPost' : null,
+      msOcupado: t.trabajo ? Date.now() - t.trabajo.inicio : 0, msCarga: t.msCarga,
+      heapMb: t.memoria ? Math.round(t.memoria.heapUsed / 1048576) : null })), cola: this.cola.length, metricas: this.metricas };
+  }
+
+  async cerrar(msEspera) {
+    this.cerrando = true;
+    const hasta = Date.now() + (msEspera || 30000);
+    while (this.trabajadores.some(t => t.trabajo) && Date.now() < hasta) await new Promise(r => setTimeout(r, 100));
+    clearInterval(this.vigia);
+    await Promise.all(this.trabajadores.map(t => t.worker.terminate().catch(() => {})));
+  }
+}
+
+module.exports = { Pool };
