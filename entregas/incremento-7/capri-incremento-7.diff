+      if (p.cuerpo && p.tipo) headers['Content-Type'] = p.tipo;
+      const r = await fetchExterno(p.url, { method: p.metodo, headers, body: p.cuerpo ? Buffer.from(p.cuerpo) : undefined,
+        redirect: p.seguirRedirecciones ? 'follow' : 'manual', signal: AbortSignal.timeout(tiempo) });
+      const cab = {};
+      r.headers.forEach((v, k) => { cab[k] = v; });
+      return { codigo: r.status, cabeceras: cab, cuerpo: Buffer.from(await r.arrayBuffer()) };
+    },
+  };
+}
+
+module.exports = { crearConductorGoogle, credencialDesde, ALCANCES, PLANTILLAS_APPS_SCRIPT };
diff --git a/servidor/src/backends/memoria.js b/servidor/src/backends/memoria.js
new file mode 100644
index 0000000..bf58e0d
--- /dev/null
+++ b/servidor/src/backends/memoria.js
@@ -0,0 +1,197 @@
+// Backend "memoria": Google simulado, sin red. Reproduce la semántica de tests/arnes.js (mismos ids F#/A#/S#, mismas
+// ligas, mismo Drive que comparte con el dominio lo nuevo y no deja quitar un permiso heredado), para que la prueba de
+// paridad compare el arnés directo contra el servidor completo (HTTP → trabajador → fachada → espejo → diario).
+// Opcional: latencia simulada por tipo de llamada, para medir estrategias (pruebas/medir.js).
+'use strict';
+const M = require('../espejo/modelo');
+
+const ARNES = {
+  archivo: 'https://drive.google.com/file/d/{id}/view',
+  carpeta: 'https://drive.google.com/drive/folders/{id}',
+  libro: 'https://sheets/{id}',
+};
+const dormir = ms => new Promise(r => setTimeout(r, ms));
+const clonar = x => structuredClone(x);
+const MIME_CARPETA = 'application/vnd.google-apps.folder', MIME_LIBRO = 'application/vnd.google-apps.spreadsheet';
+
+class ConductorMemoria {
+  constructor(o) {
+    const op = o || {};
+    this.nombre = 'memoria';
+    this.plantillas = op.plantillas || ARNES;
+    this.n = 0;
+    this.libros = new Map();
+    this.items = new Map(); // id → {id, nombre, carpeta, padre, acceso, papelera, mime, datos, libro}
+    this.correos = [];
+    this.fallarCorreo = false;
+    this.fallarConfirmar = null; // (libroId, ops) => Error | null  (pruebas de fallas)
+    this.rutas = op.rutas || [];  // [{re, fn(peticion) → {codigo, cuerpo}}]
+    this.latencia = op.latencia || null;
+    this.llamadas = {};
+    this.raizId = null;
+    this.drive = this.crearDrive();
+  }
+
+  async espera(tipo, extra) {
+    this.llamadas[tipo] = (this.llamadas[tipo] || 0) + 1;
+    const ms = this.latencia && (this.latencia[tipo] || 0) + (extra || 0);
+    if (ms) await dormir(ms);
+  }
+
+  // ---------- Sheets ----------
+  async cargarLibro(id) {
+    await this.espera('sheets.leer');
+    const l = this.libros.get(id);
+    if (!l) throw Object.assign(new Error('No se encontró la hoja de cálculo ' + id + '.'), { codigo: 404 });
+    return clonar(l);
+  }
+
+  async crearLibro(nombre) {
+    await this.espera('sheets.crear');
+    const id = 'S' + (++this.n);
+    const l = M.nuevoLibro({ id, titulo: nombre, hojas: [{ id: 0, titulo: 'Hoja 1', indice: 0 }] });
+    this.libros.set(id, l);
+    this.items.set(id, { id, nombre, carpeta: false, padre: this.raizId, acceso: 'DOMAIN', mime: MIME_LIBRO, libro: true });
+    return clonar(l);
+  }
+
+  async confirmar(libro, ops) {
+    await this.espera('sheets.escribir');
+    if (this.fallarConfirmar) { const e = this.fallarConfirmar(libro.id, ops); if (e) throw e; }
+    const remoto = this.libros.get(libro.id);
+    if (!remoto) throw new Error('No se encontró la hoja de cálculo ' + libro.id + '.');
+    // Atómico como batchUpdate: se aplica a una copia y solo si todo salió bien se queda
+    const copia = clonar(remoto);
+    ops.forEach(op => M.aplicar(copia, op));
+    copia.version = String(Number(remoto.version || 0) + 1);
+    this.libros.set(libro.id, copia);
+    return clonar(copia);
+  }
+
+  async versionLibro(id) {
+    await this.espera('drive.version');
+    const l = this.libros.get(id);
+    if (!l) throw new Error('No se encontró ' + id);
+    return String(l.version || 0);
+  }
+
+  /** Para pruebas: una persona edita la hoja directo en Sheets (cambia la versión). */
+  editarAMano(id, f) {
+    const l = this.libros.get(id);
+    f(l);
+    l.version = String(Number(l.version || 0) + 1);
+  }
+
+  // ---------- Drive ----------
+  meta(it) {
+    return { id: it.id, nombre: it.nombre, carpeta: !!it.carpeta, padres: it.padre ? [it.padre] : [], papelera: !!it.papelera,
+      mime: it.mime, libro: !!it.libro, tamano: it.datos ? it.datos.length : 0 };
+  }
+  item(id) {
+    const it = this.items.get(id);
+    if (!it) throw Object.assign(new Error('No se encontró el elemento con el ID ' + id + ' o no tienes permiso para abrirlo.'), { codigo: 404 });
+    return it;
+  }
+  nuevoItem(prefijo, d) {
+    const id = prefijo + (++this.n);
+    const it = Object.assign({ id, acceso: 'DOMAIN', papelera: false }, d);
+    this.items.set(id, it);
+    return it;
+  }
+  crearDrive() {
+    const c = this;
+    return {
+      async obtener({ id }) { await c.espera('drive.leer'); return c.meta(c.item(id)); },
+      async raiz() { await c.espera('drive.leer'); return c.meta(c.item(c.raizId)); },
+      async hijos({ padre, nombre, carpetas }) {
+        await c.espera('drive.leer');
+        return [...c.items.values()].filter(it => it.padre === padre && !!it.carpeta === !!carpetas && (nombre == null || it.nombre === nombre))
+          .map(it => c.meta(it));
+      },
+      async buscar({ nombre, carpetas }) {
+        await c.espera('drive.leer');
+        return [...c.items.values()].filter(it => it.nombre === nombre && !!it.carpeta === !!carpetas && !it.papelera).map(it => c.meta(it));
+      },
+      async crearCarpeta({ padre, nombre }) {
+        await c.espera('drive.escribir');
+        return c.meta(c.nuevoItem('F', { nombre, carpeta: true, padre: padre || c.raizId, mime: MIME_CARPETA }));
+      },
+      async crearArchivo({ padre, nombre, mime, datos }) {
+        await c.espera('drive.subir', datos ? Math.round(datos.length / 50000) : 0);
+        c.item(padre);
+        return c.meta(c.nuevoItem('A', { nombre, carpeta: false, padre, mime, datos: Buffer.from(datos || []) }));
+      },
+      async renombrar({ id, nombre }) { await c.espera('drive.escribir'); const it = c.item(id); it.nombre = nombre; return c.meta(it); },
+      async mover({ id, destino }) { await c.espera('drive.escribir'); const it = c.item(id); c.item(destino); it.padre = destino; return c.meta(it); },
+      async papelera({ id, papelera }) { await c.espera('drive.escribir'); const it = c.item(id); it.papelera = !!papelera; return c.meta(it); },
+      async personas({ id }) { await c.espera('drive.leer'); c.item(id); return { editores: [], lectores: [], dueno: null }; },
+      async contenido({ id }) {
+        await c.espera('drive.leer');
+        const it = c.item(id);
+        return { nombre: it.nombre, mime: it.mime, datos: Buffer.from(it.datos || []) };
+      },
+    };
+  }
+
+  /** Llamadas REST a googleapis.com con el token del script: hoy solo los permisos de Drive (privado_). */
+  async fetchGoogle(p) {
+    await this.espera('drive.permisos');
+    const resp = (codigo, cuerpo) => ({ codigo, cabeceras: { 'content-type': 'application/json' }, cuerpo: Buffer.from(cuerpo == null ? '' : JSON.stringify(cuerpo)) });
+    const m = p.url.match(/drive\/v3\/files\/([^/?]+)\/permissions(?:\/([^?]+))?/);
+    if (!m) return resp(404, { error: { message: 'sin ruta simulada: ' + p.url } });
+    const it = this.items.get(decodeURIComponent(m[1]));
+    if (!it) return resp(404, { error: { message: 'File not found' } });
+    let heredado = false;
+    for (let f = it.padre && this.items.get(it.padre); f; f = f.padre && this.items.get(f.padre)) if (f.acceso === 'DOMAIN') heredado = true;
+    if (p.metodo === 'DELETE') {
+      if (heredado) return resp(403, { error: { reason: 'cannotDeletePermission' } });
+      it.acceso = 'PRIVATE';
+      return { codigo: 204, cabeceras: {}, cuerpo: Buffer.alloc(0) };
+    }
+    return resp(200, { permissions: [{ id: 'own', type: 'user' }].concat(it.acceso === 'DOMAIN' || heredado ? [{ id: 'dom', type: 'domain' }] : []) });
+  }
+
+  async fetch(p) {
+    await this.espera('http');
+    const ruta = this.rutas.find(r => r.re.test(p.url));
+    const deTexto = c => (Buffer.isBuffer(c) ? c : Buffer.from(typeof c === 'string' ? c : JSON.stringify(c == null ? {} : c)));
+    if (ruta) { const r = ruta.fn(p); return { codigo: r.codigo == null ? 200 : r.codigo, cabeceras: r.cabeceras || {}, cuerpo: deTexto(r.cuerpo) }; }
+    return { codigo: 404, cabeceras: {}, cuerpo: deTexto({ error: 'sin ruta simulada: ' + p.url }) };
+  }
+
+  async enviarCorreo(m) {
+    await this.espera('correo');
+    if (this.fallarCorreo) throw new Error('Servicio de correo no disponible');
+    this.correos.push(m);
+  }
+
+  /** Como el arnés: el "PDF" es el mismo HTML (no hay Chromium en las pruebas). */
+  async pdf(html) {
+    await this.espera('pdf');
+    return Buffer.from(String(html));
+  }
+
+  /**
+   * Estado inicial igual al de tests/arnes.js: Mi unidad (F1, privada) / Cotizador Helgen (F2) / Cotizaciones Helgen (PDF)
+   * (F3), la base de datos "DB" (Config con PREFIJO_FOLIO e IVA_TASA; Cotizaciones vacía) y el catálogo "CAT".
+   * Devuelve las Script Properties iniciales.
+   */
+  sembrarComoArnes() {
+    const mi = this.nuevoItem('F', { nombre: 'Mi unidad', carpeta: true, padre: null, mime: MIME_CARPETA, acceso: 'PRIVATE' });
+    this.raizId = mi.id;
+    const maestra = this.nuevoItem('F', { nombre: 'Cotizador Helgen', carpeta: true, padre: mi.id, mime: MIME_CARPETA });
+    const pdf = this.nuevoItem('F', { nombre: 'Cotizaciones Helgen (PDF)', carpeta: true, padre: maestra.id, mime: MIME_CARPETA });
+    // En el arnés "DB" está en Drive (sin acceso propio: hereda el de la carpeta maestra) y "CAT" no
+    this.items.set('DB', { id: 'DB', nombre: 'Base de datos', carpeta: false, padre: maestra.id, mime: MIME_LIBRO, libro: true, papelera: false });
+    this.libros.set('DB', M.nuevoLibro({ id: 'DB', titulo: 'Base de datos', hojas: [
+      { id: 0, titulo: 'Config', indice: 0, valores: [['Clave', 'Valor'], ['PREFIJO_FOLIO', 'HLG'], ['IVA_TASA', 0.16]] },
+      { id: 1, titulo: 'Cotizaciones', indice: 1, valores: [] }] }));
+    this.libros.set('CAT', M.nuevoLibro({ id: 'CAT', titulo: 'Catálogo', hojas: [
+      { id: 0, titulo: 'Catalogo', indice: 0, valores: [
+        ['Clave', 'Descripción', 'Unidad', 'Precio unitario (sin IVA)', 'Actualizado', 'Actualizó', 'Clave SAT', 'Unidad SAT'],
+        ['PAN-550', 'Panel solar 550 W', 'PZA', 4100, '', '', '', '']] }] }));
+    return { SPREADSHEET_ID: 'DB', FOLDER_ID: pdf.id, CATALOGO_ID: 'CAT' };
+  }
+}
+
+module.exports = { ConductorMemoria, PLANTILLAS_ARNES: ARNES };
diff --git a/servidor/src/espejo/entrada.js b/servidor/src/espejo/entrada.js
new file mode 100644
index 0000000..e519d43
--- /dev/null
+++ b/servidor/src/espejo/entrada.js
@@ -0,0 +1,200 @@
+// Cómo guarda Google Sheets lo que escribe Apps Script con setValue / setValues / appendRow: la entrada es
+// "USER_ENTERED", o sea, el texto se interpreta como si alguien lo tecleara en la celda (número, fecha, hora, booleano,
+// fórmula) según el idioma/región (locale) del libro y el formato de número de la celda.
+//
+// spreadsheets.batchUpdate (la llamada atómica del diario) no tiene valueInputOption: solo lo tienen values.update y
+// values.batchUpdate, que costarían otra llamada por libro y la atomicidad (estructura y valores en dos llamadas). Por eso
+// la conversión se hace aquí, en el trabajador, al escribir: el código lee en la línea siguiente lo ya convertido (como en
+// Apps Script) y el diario lleva cada celda ya tipada (número, Date, booleano, fórmula o texto literal) con el formato que
+// Sheets le pondría. Cada operación del diario anota entrada: 'USER_ENTERED' (setValue, setValues, appendRow) o 'RAW'
+// (setFormula y lo que escribe el propio servidor).
+//
+// Reglas, en orden (docs/servidor-etapa-1.md §4.4; casos en pruebas/casos-escritura.js):
+//   1. No es texto (número, booleano, Date, vacío): tal cual.
+//   2. Empieza con apóstrofo: texto literal sin el apóstrofo (lo que hace textoCelda / textoFecha_ de Code.js).
+//   3. Celda con formato de texto plano ("@"): queda texto SIEMPRE (también una fecha ISO), salvo "=" (sigue siendo
+//      fórmula).
+//   4. Empieza con "=": fórmula. Un "+" o un "-" al inicio NO hacen fórmula por esta vía.
+//   5. Booleano (solo TRUE/FALSE en inglés, en cualquier locale), número (separadores del locale, signo "-", "$", "%",
+//      miles bien agrupados, exponente; más de 15 cifras significativas queda texto), fecha, fecha y hora u hora
+//      (sin am/pm).
+//   6. Lo demás: texto.
+//
+// Las 6 reglas se MIDIERON con Apps Script real el 29/10/2026 (herramientas/paridad-escritura.js, 49 casos, corrida de
+// Leo): 10 de ellos contradecían lo que este archivo suponía. Lo que cambió, con su caso en pruebas/casos-escritura.js:
+// un "+" al inicio no hace número ni fórmula ("+5", "+52 442 644 5391" → texto); "-abc" → texto; más de 15 cifras
+// significativas → texto ("012345678901234567", el largo de una CLABE, se guardaba con las cifras cambiadas);
+// "VERDADERO" → texto; "5:30 pm" → texto; una celda "@" no convierte fechas ISO (al revés de lo que dice CLAUDE.md
+// §6.2); "=A1" en una celda "@" sí es fórmula; y un número escrito como texto en una celda con formato de fecha deja
+// la celda en formato automático. NO cambiar ninguna de estas reglas sin volver a medir.
+'use strict';
+
+const LOCALE_OMISION = 'es_MX';
+const porLocale = new Map();
+
+const escapar = c => c.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
+
+/** Separadores y orden de la fecha del locale de Sheets ("es_MX", "en_US"…), con Intl (ICU completo en Node). */
+function datosLocale(locale) {
+  const clave = String(locale || LOCALE_OMISION);
+  let d = porLocale.get(clave);
+  if (d) return d;
+  const tag = clave.replace(/_/g, '-');
+  let decimal = '.', grupo = ',', orden = 'dmy';
+  try {
+    const p = new Intl.NumberFormat(tag, { useGrouping: true }).formatToParts(1234567.5);
+    decimal = (p.find(x => x.type === 'decimal') || {}).value || '.';
+    grupo = (p.find(x => x.type === 'group') || {}).value || (decimal === ',' ? '.' : ',');
+    const f = new Intl.DateTimeFormat(tag, { year: 'numeric', month: 'numeric', day: 'numeric' }).formatToParts(new Date(2026, 10, 25));
+    const o = f.filter(x => x.type === 'day' || x.type === 'month' || x.type === 'year').map(x => x.type[0]).join('');
+    if (/^(dmy|mdy|ymd)$/.test(o)) orden = o;
+  } catch (e) { /* locale que ICU no conoce: el de México */ }
+  const g = /\s/.test(grupo) ? '[ \\u00a0\\u202f]' : escapar(grupo);
+  const dd = escapar(decimal);
+  const simple = '(?:\\d+(?:' + dd + '\\d*)?|' + dd + '\\d+)';
+  const agrupado = '\\d{1,3}(?:' + g + '\\d{3})+(?:' + dd + '\\d*)?';
+  d = {
+    locale: clave, decimal, grupo, orden,
+    espanol: /^es/i.test(clave),
+    // signo, "$", signo (uno solo en total), mantisa, "%"
+    reNumero: new RegExp('^([+-]?)(\\$?)([+-]?)(' + agrupado + '|' + simple + ')(%?)$'),
+    reExponente: new RegExp('^([+-]?)(' + simple + ')[eE]([+-]?\\d{1,3})$'),
+    reGrupo: new RegExp(g, 'g'),
+  };
+  porLocale.set(clave, d);
+  return d;
+}
+
+const cifras15 = n => (n === 0 ? 0 : Number(n.toPrecision(15)));
+
+/** Cifras significativas de una mantisa ya normalizada ("1234.56"): sin ceros a la izquierda ni a la derecha. */
+const significativas = m => m.replace(/^0+/, '').replace('.', '').replace(/^0+/, '').replace(/0+$/, '').length;
+
+function numero(t, L) {
+  let m = L.reNumero.exec(t);
+  if (m) {
+    const [, s1, pesos, s2, mantisa, porciento] = m;
+    if ((s1 && s2) || (pesos && porciento) || (s2 && !pesos)) return null;
+    if (s1 === '+' || s2 === '+') return null; // "+5" queda texto (medido)
+    const signo = (s1 || s2) === '-' ? -1 : 1;
+    const agrupado = L.reGrupo.test(mantisa);
+    L.reGrupo.lastIndex = 0;
+    const limpio = mantisa.replace(L.reGrupo, '').replace(L.decimal, '.');
+    L.reGrupo.lastIndex = 0;
+    if (significativas(limpio) > 15) return null; // "012345678901234567" (CLABE) queda texto, no un número cambiado
+    let n = Number(limpio);
+    if (!isFinite(n)) return null;
+    const conDecimales = mantisa.includes(L.decimal) && !mantisa.endsWith(L.decimal);
+    n = signo * n;
+    if (porciento) return { valor: cifras15(n / 100), tipo: 'PERCENT', patron: conDecimales ? '0.00%' : '0%' };
+    if (pesos) return { valor: cifras15(n), tipo: 'CURRENCY', patron: '"$"#,##0.00' };
+    if (agrupado) return { valor: cifras15(n), tipo: 'NUMBER', patron: conDecimales ? '#,##0.00' : '#,##0' };
+    return { valor: cifras15(n) };
+  }
+  m = L.reExponente.exec(t);
+  if (m) {
+    if (m[1] === '+') return null;
+    const n = Number((m[1] === '-' ? '-' : '') + m[2].replace(L.decimal, '.') + 'e' + m[3]);
+    if (!isFinite(n)) return null;
+    return { valor: cifras15(n), tipo: 'SCIENTIFIC', patron: '0.00E+00' };
+  }
+  return null;
+}
+
+// ---- Fechas y horas ----
+const MS_DIA = 86400000, EPOCA = 25569;
+const diasDelMes = (a, m) => new Date(Date.UTC(a, m, 0)).getUTCDate();
+// Sin am/pm: "5:30 pm" queda texto (medido con Apps Script real)
+const RE_HORA = '(\\d{1,2}):(\\d{2})(?::(\\d{2}))?';
+const RE_ISO = new RegExp('^(\\d{4})([-/])(\\d{1,2})\\2(\\d{1,2})(?:\\s+' + RE_HORA + ')?$');
+const RE_NUMERICA = new RegExp('^(\\d{1,2})([/-])(\\d{1,2})(?:\\2(\\d{4}|\\d{2}))?(?:\\s+' + RE_HORA + ')?$');
+const RE_SOLO_HORA = new RegExp('^' + RE_HORA + '$');
+/** Hora "h:mm[:ss]" → segundos del día, o null si no es válida. */
+function segundosDeHora(h, mi, s) {
+  const hh = Number(h), m = Number(mi), ss = s === undefined ? 0 : Number(s);
+  if (m > 59 || ss > 59 || hh > 23) return null;
+  return hh * 3600 + m * 60 + ss;
+}
+
+const patronHora = s => (s === undefined ? 'hh:mm' : 'hh:mm:ss');
+
+/** Fecha de pared (año, mes, día, segundos del día) en la zona del libro → Date (el instante que da getValues). */
+function fechaDePared(a, m, d, seg, desdeSerial, zona) {
+  const serial = Date.UTC(a, m - 1, d) / MS_DIA + EPOCA + seg / 86400;
+  return desdeSerial(serial, zona);
+}
+
+function fecha(t, L, ctx) {
+  let m = RE_ISO.exec(t);
+  let a, mes, dia, conHora = false, seg = 0, ph = '', base;
+  if (m) {
+    a = Number(m[1]); mes = Number(m[3]); dia = Number(m[4]);
+    base = m[2] === '-' ? 'yyyy-mm-dd' : 'yyyy/mm/dd';
+    if (m[5] !== undefined) { conHora = true; seg = segundosDeHora(m[5], m[6], m[7]); ph = patronHora(m[7]); }
+  } else if ((m = RE_NUMERICA.exec(t)) && L.orden !== 'ymd') {
+    if (m[4] === undefined && m[2] !== '/') return null; // "3/4" sí; "3-4" no
+    const x = Number(m[1]), y = Number(m[3]);
+    if (L.orden === 'mdy') { mes = x; dia = y; } else { dia = x; mes = y; }
+    if (m[4] === undefined) a = ctx.anioActual;
+    else a = m[4].length === 2 ? (Number(m[4]) < 30 ? 2000 : 1900) + Number(m[4]) : Number(m[4]);
+    base = L.orden === 'mdy' ? 'mm/dd/yyyy' : 'dd/mm/yyyy';
+    if (m[2] === '-') base = base.replace(/\//g, '-');
+    if (m[5] !== undefined) { conHora = true; seg = segundosDeHora(m[5], m[6], m[7]); ph = patronHora(m[7]); }
+  } else if ((m = RE_SOLO_HORA.exec(t))) {
+    const s = segundosDeHora(m[1], m[2], m[3]);
+    if (s === null) return null;
