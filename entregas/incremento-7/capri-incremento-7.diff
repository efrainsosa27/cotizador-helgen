+// P12 · (Correcto) Tiempo del lector con XML hostiles de ~2 MB (el máximo de validarXml): atributo enorme, muchas etiquetas sin cerrar,
+// miles de atributos y comillas sin cerrar. El patrón de etiquetas no tiene retroceso catastrófico: todo en milisegundos.
+// Uso: node revision/p12-xml-grande.js
+'use strict';
+const C = require('./comun');
+const A = C.crearArnes();
+const casos = {
+  'atributo de 2 MB': C.cfdi({ nombreReceptor: 'X'.repeat(2e6) }),
+  '100k etiquetas abiertas': C.cfdi({}).replace('</cfdi:Comprobante>', '<a x="1" '.repeat(1e5) + '</cfdi:Comprobante>'),
+  'comillas sin cerrar': C.cfdi({}).replace('<cfdi:Emisor', '<z a="' + '<b c="'.repeat(2e5) + '<cfdi:Emisor'),
+  'atributos sin fin': '<cfdi:Comprobante ' + 'a="1" '.repeat(3e5),
+};
+for (const [k, s] of Object.entries(casos)) {
+  const t = Date.now();
+  let r; try { r = A.ctx.leerCfdiCliente(s).uuid; } catch (e) { r = 'error: ' + e.message.slice(0, 70); }
+  console.log(k.padEnd(24), (Date.now() - t + ' ms').padStart(7), '·', r);
+}
diff --git a/tests/revision7/importar/p2-zip-bomba.js b/tests/revision7/importar/p2-zip-bomba.js
new file mode 100644
index 0000000..c51f36a
--- /dev/null
+++ b/tests/revision7/importar/p2-zip-bomba.js
@@ -0,0 +1,44 @@
+// Copia de la revisión 7c (capri-7rev3/revision/) para la rama incremento-7-fix-importar: antes del arreglo esta prueba de concepto
+// confirmaba el defecto; ahora comprueba lo corregido (la prueba permanente es tests/revision7-importar.test.js). Uso: bash tests/revision7/correr.sh
+// P2 · ZIP: los límites se revisan DESPUÉS de inflar todo. entradasDeZip_ llama descomprimir_ (Utilities.unzip, que infla cada
+// entrada completa en memoria) y solo después cuenta entradas (MAX_ENTRADAS_ZIP) y bytes (MAX_DESCOMPRIMIDO). Además el límite de
+// 60 MB es por ZIP, no por envío, y lo inflado se guarda en `entradas` hasta el final de importarFacturasClientes.
+//  A) Un ZIP de ~0.6 MB que se infla a 600 MB: se infla entero y recién entonces se rechaza "pesa más de 60 MB".
+//  B) Un envío dentro de TODOS los límites (≤ 60 archivos, ≤ 20 MB comprimido, cada ZIP ≤ 60 MB inflado) que retiene N × 59 MB a la vez.
+// Uso: node revision/p2-zip-bomba.js
+'use strict';
+const assert = require('assert');
+const C = require('./comun');
+const A = C.crearArnes();
+const MB = 1024 * 1024;
+const mem = () => Math.round((process.memoryUsage().arrayBuffers + process.memoryUsage().heapUsed) / MB);
+
+// ---- A) bomba: 600 MB de ceros en un "factura.xml" ----
+const bomba = C.crearZip([{ nombre: 'factura.xml', datos: Buffer.alloc(600 * MB, 0x20) }]);
+console.log('A) ZIP de', (bomba.length / MB).toFixed(2), 'MB comprimido');
+let pico = 0;
+const unzip0 = A.ctx.Utilities.unzip;
+A.ctx.Utilities.unzip = b => { const r = unzip0(b); pico = Math.max(pico, mem()); return r; };
+const antes = C.inflado();
+let r = A.ok('tania', 'importarFacturasClientes', { archivos: [{ nombre: 'contalink.zip', datos: bomba.toString('base64') }], idSolicitud: C.id('z') });
+console.log('   inflado por descomprimir_:', Math.round((C.inflado() - antes) / MB), 'MB · memoria en el pico:', pico, 'MB · resultado:', r.resultados[0].mensaje);
+assert(C.inflado() - antes === 0 && /más de 60 MB/.test(r.resultados[0].mensaje), 'ARREGLADO: se rechaza por su índice, sin inflar nada');
+
+// ---- B) dentro de los límites: N ZIPs con un PDF de 59 MB cada uno (cada ZIP pasa los 60 MB); todo queda vivo en `entradas` ----
+const N = Number(process.argv[2]) || 12;
+const pdf59 = Buffer.alloc(59 * MB, 0); pdf59.write('%PDF-1.7');
+const zip59 = C.crearZip([{ nombre: 'A-101.pdf', datos: pdf59 }]);
+const archivos = Array.from({ length: N }, (_, i) => ({ nombre: 'parte' + i + '.zip', datos: zip59.toString('base64') }));
+const comprimido = archivos.reduce((s, a) => s + Buffer.from(a.datos, 'base64').length, 0);
+const vivos = [];
+A.ctx.Utilities.unzip = b => { const r = unzip0(b); vivos.push(mem()); return r; };
+global.gc && global.gc();
+const base = mem();
+r = A.ok('tania', 'importarFacturasClientes', { archivos, idSolicitud: C.id('z') });
+console.log('B) envío de', N, 'ZIP =', (comprimido / MB).toFixed(2), 'MB comprimido (límite 20 MB, ' + N + ' de 60 archivos)');
+console.log('   memoria tras cada ZIP (MB):', vivos.map(v => v - base).join(' → '), '· resultados:', [...new Set(r.resultados.map(x => x.estado + ': ' + x.mensaje))].join(' | '));
+assert.equal(vivos.length, 1, 'ARREGLADO: el presupuesto es por envío: solo el primer ZIP se infla');
+assert(r.resultados.filter(x => /junto con lo demás de este envío/.test(x.mensaje)).length === N - 1, 'los demás se rechazan sin inflarse');
+console.log('   → antes del arreglo, con 60 ZIP (≈' + (zip59.length * 60 / MB).toFixed(1) + ' MB comprimido) eran ≈' + Math.round(60 * 59 / 1024 * 10) / 10 +
+  ' GB inflados y retenidos; ahora, a lo más 60 MB por envío.');
+console.log('ARREGLADO: el índice se revisa antes de inflar y el límite de lo inflado es por envío.');
diff --git a/tests/revision7/importar/p3-rep-grande-aborta-lote.js b/tests/revision7/importar/p3-rep-grande-aborta-lote.js
new file mode 100644
index 0000000..5375672
--- /dev/null
+++ b/tests/revision7/importar/p3-rep-grande-aborta-lote.js
@@ -0,0 +1,46 @@
+// Copia de la revisión 7c (capri-7rev3/revision/) para la rama incremento-7-fix-importar: antes del arreglo esta prueba de concepto
+// confirmaba el defecto; ahora comprueba lo corregido (la prueba permanente es tests/revision7-importar.test.js). Uso: bash tests/revision7/correr.sh
+// P3 · Un solo complemento de pago grande tumba todo el envío y deja archivos huérfanos en Drive.
+// filaFacturaCliente lanza "El CFDI trae demasiados pagos para guardarlo" (pagos JSON > MAX_JSON_CELDA) DENTRO de conCandado_,
+// después de que los XML/PDF de TODO el lote ya se crearon en Drive. Resultado: la llamada falla entera (contra "un archivo malo no
+// detiene a los demás"), ninguna factura se guarda, y los archivos privados creados no se mandan a la Papelera (`creados` se llena
+// pero nunca se usa). Cada reintento crea otra copia.
+// Uso: node revision/p3-rep-grande-aborta-lote.js
+'use strict';
+const assert = require('assert');
+const C = require('./comun');
+const A = C.crearArnes();
+
+const I1 = C.cfdi({ uuid: C.U(1), folio: '101' });
+// REP de Helgen que paga 400 facturas (pagos JSON ≈ 55 000 caracteres > 45 000); el XML pesa ~110 KB (< 2 MB)
+const docs = Array.from({ length: 400 }, (_, i) => ({ uuid: C.U(5000 + i), ant: '100.00', pagado: '100.00', insoluto: '0.00', folio: String(i) }));
+const P1 = C.cfdi({ tipo: 'P', uuid: C.U(900), serie: 'P', folio: '1', pagos: [{ fecha: '2026-10-20', monto: '40000.00', docs }] });
+console.log('XML del REP:', Math.round(P1.length / 1024), 'KB');
+const envio = () => A.post('tania', 'importarFacturasClientes', { archivos: [{ nombre: 'A-101.xml', datos: C.b64(I1) },
+  { nombre: 'A-101.pdf', datos: A.PDF }, { nombre: 'REP-1.xml', datos: C.b64(P1) }], idSolicitud: 'mismo-envio' });
+
+const huerfanos = () => Object.values(A.archivos).filter(a => a.blob && /Factura|Complemento/.test(a.blob.name) && !a.trashed).length;
+for (let intento = 1; intento <= 2; intento++) {
+  const r = envio();
+  const filas = (A.libros[A.props.COBRANZA_DB_ID].pest.FacturasClientes || { m: [] }).m.length - 1;
+  console.log('Intento', intento + ':', r.ok ? 'ok' : 'FALLA → ' + r.error, '· filas en FacturasClientes:', Math.max(0, filas),
+    '· archivos de facturas vivos en Drive:', huerfanos());
+  assert.equal(r.ok, true, 'ARREGLADO: el envío no se cae');
+  assert(/demasiados pagos/.test(r.datos.resultados.find(x => x.archivo === 'REP-1.xml').mensaje), 'el REP se rechaza solo');
+}
+assert.equal(huerfanos(), 2, 'ARREGLADO: la factura y su PDF (del REP no se crea nada; el reintento no crea otra copia)');
+console.log('ARREGLADO: el REP que no cabe se rechaza solo, la factura buena se guarda y nada queda huérfano.');
+
+// Variante B: lo mismo con un texto de más de 50 000 caracteres en una celda normal (Nombre del receptor de 60 000). Sheets rechaza la
+// celda (límite de 50 000 que el propio código cita en MAX_JSON_CELDA); aquí se simula ese límite en setValues/appendRow.
+const B = C.crearArnes();
+const escribe0 = B.ctx.escribe_;
+const limite = v => { if (v.some(f => f.some(c => typeof c === 'string' && c.length > 50000))) throw new Error('Your input contains more than the maximum of 50000 characters in a single cell.'); };
+B.ctx.escribe_ = hoja => { const h = escribe0(hoja);
+  return Object.assign(Object.create(h), { appendRow: f => { limite([f]); return h.appendRow(f); },
+    getRange: (...a) => { const r = h.getRange(...a); return Object.assign(Object.create(r), { setValues: v => { limite(v); return r.setValues(v); } }); } }); };
+const rB = B.post('tania', 'importarFacturasClientes', { archivos: [{ nombre: 'A-101.xml', datos: C.b64(I1) },
+  { nombre: 'A-102.xml', datos: C.b64(C.cfdi({ uuid: C.U(2), folio: '102', nombreReceptor: 'N'.repeat(60000) })) }], idSolicitud: 'b' });
+const vivosB = Object.values(B.archivos).filter(a => a.blob && /Factura/.test(a.blob.name) && !a.trashed).length;
+console.log('Variante B (nombre de 60 000 caracteres):', rB.ok ? 'ok' : 'FALLA → ' + rB.error, '· archivos huérfanos:', vivosB);
+assert(rB.ok && rB.datos.conteos.importadas === 2 && vivosB === 2, 'ARREGLADO: el nombre se recorta al largo del SAT; las dos se guardan');
diff --git a/tests/revision7/importar/p4-formula-monedap.js b/tests/revision7/importar/p4-formula-monedap.js
