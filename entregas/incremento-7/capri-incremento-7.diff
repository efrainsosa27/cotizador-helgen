+const rsT = ok('tania', 'resumenCobranzaGeneral'), rpT = ok('tania', 'reporteMargen');
+assert.deepEqual([rsT.proyectos.find(p => p.folio === pA).margen, rsT.nominaOculta, rpT.proyectos.find(p => p.folio === pA).margen, rpT.nominaOculta],
