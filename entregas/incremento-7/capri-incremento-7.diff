diff --git a/servidor/despliegue/actualizar.sh b/servidor/despliegue/actualizar.sh
new file mode 100755
index 0000000..7de8697
--- /dev/null
+++ b/servidor/despliegue/actualizar.sh
@@ -0,0 +1,105 @@
+#!/usr/bin/env bash
+# Actualiza CAPRI en el servidor: trae el código (git), construye la imagen nueva (etiqueta = commit), corre las pruebas
+# del servidor DENTRO de esa imagen (sin Google ni red), cambia el contenedor y espera a que quede sano. Si algo falla
+# antes del cambio, no se toca nada; si falla después, regresa solo a la imagen anterior (sigue en el servidor).
+#
+# Uso (como el dueño del repositorio; si no está en el grupo docker, usa sudo para docker):
+#   servidor/despliegue/actualizar.sh [rama]                 por omisión: main
+#   servidor/despliegue/actualizar.sh --regresar [etiqueta]  a la imagen anterior (o a esa etiqueta = commit corto)
+#   servidor/despliegue/actualizar.sh --estado
+# Cuándo: fuera de horario (el cambio deja ~5–15 s sin servicio: la interfaz muestra "CAPRI se está actualizando").
+set -euo pipefail
+# Este archivo vive en el repositorio y el git checkout de abajo lo cambia mientras bash lo lee: se corre una copia
+YO=servidor/despliegue/actualizar.sh
+if [ -z "${CAPRI_ACTUALIZAR_COPIA:-}" ]; then
+  COPIA=$(mktemp "${TMPDIR:-/tmp}/capri-actualizar.XXXXXX")
+  cp "$0" "$COPIA"
+  CAPRI_ACTUALIZAR_COPIA="$COPIA" exec bash "$COPIA" "$@"
+fi
+trap 'rm -f "$CAPRI_ACTUALIZAR_COPIA"' EXIT
+APP=${CAPRI_APP:-/srv/projects/capri/app}
+cd "$APP/servidor"
+[ -f .env ] || { echo "Falta servidor/.env: corre primero despliegue/preparar-servidor.sh."; exit 1; }
+if docker info >/dev/null 2>&1; then SUDO=(); else SUDO=(sudo); fi
+dk() { "${SUDO[@]}" docker "$@"; }
+dc() { local v="$1"; shift; "${SUDO[@]}" env CAPRI_VERSION="$v" docker compose "$@"; }
+ACTUAL=$(sed -n 's/^CAPRI_VERSION=//p' .env)
+
+sano() {  # espera a que el contenedor corra la etiqueta $1 y su HEALTHCHECK diga healthy (máx. 2 min)
+  local s img
+  for _ in $(seq 1 120); do
+    img=$(dk inspect -f '{{.Config.Image}}' capri 2>/dev/null || true)
+    s=$(dk inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{end}}' capri 2>/dev/null || true)
+    if [ "$img" = "capri:$1" ] && [ "$s" = healthy ]; then return 0; fi
+    if [ "$img" = "capri:$1" ] && [ "$s" = unhealthy ]; then return 1; fi
+    sleep 1
+  done
+  return 1
+}
+fijar() {  # deja $1 como la versión en servidor/.env (la que usa "docker compose up -d" sin nada más)
+  sed -i "s/^CAPRI_VERSION=.*/CAPRI_VERSION=$1/" .env
+}
+cambiar_a() {  # etiqueta, motivo → contenedor con esa imagen; regresa 0 si quedó sano
+  dc "$1" up -d --no-build --remove-orphans capri && sano "$1"
+}
+estado() {
+  echo "versión en .env: $ACTUAL"
+  dk ps -a --filter name=^capri$ --format 'contenedor: {{.Names}} · {{.Image}} · {{.Status}}'
+  echo "imágenes (la primera es la más nueva):"; dk image ls capri --format '  {{.Tag}}  {{.CreatedSince}}  {{.Size}}'
+}
+podar() {  # se quedan las 5 imágenes más nuevas (y siempre la que corre); las de pruebas, solo la última
+  local n=0 t
+  while read -r t; do
+    n=$((n+1)); [ "$n" -le 5 ] || [ "$t" = "$1" ] || dk image rm "capri:$t" >/dev/null 2>&1 || true
+  done < <(dk image ls capri --format '{{.Tag}}' | grep -v '^<none>$')
+  dk image ls capri-pruebas --format '{{.Tag}}' | grep -v "^$1$" | while read -r t; do dk image rm "capri-pruebas:$t" >/dev/null 2>&1 || true; done
+}
+
+case "${1:-}" in
+  --estado) estado; exit 0 ;;
+  --regresar)
+    # Sin etiqueta: la imagen construida justo antes de la que corre (la lista viene de la más nueva a la más vieja)
+    DESTINO=${2:-$(dk image ls capri --format '{{.Tag}}' | grep -v '^<none>$' | sed -n "/^$ACTUAL$/{n;p;q}")}
+    [ -n "$DESTINO" ] || { echo "No hay otra imagen de capri en el servidor."; exit 1; }
+    dk image inspect "capri:$DESTINO" >/dev/null 2>&1 || { echo "No existe la imagen capri:$DESTINO (mira: $YO --estado)."; exit 1; }
+    echo "Regreso: capri:$ACTUAL → capri:$DESTINO"
+    if cambiar_a "$DESTINO"; then
+      fijar "$DESTINO"
+      git checkout --quiet --detach "$DESTINO" 2>/dev/null || echo "(el código del repositorio no se movió: $DESTINO no es un commit)"
+      echo "✔ CAPRI en capri:$DESTINO."; exit 0
+    fi
+    echo "✘ capri:$DESTINO no quedó sana; regreso a capri:$ACTUAL"; cambiar_a "$ACTUAL" || true; exit 1
+    ;;
+esac
+
+RAMA=${1:-main}
+[ -z "$(git status --porcelain --untracked-files=no)" ] || { echo "✘ Hay cambios sin guardar en $APP: no se actualiza."; exit 1; }
+ANTERIOR=$(git rev-parse HEAD)
+volver_git() { echo "✘ $1: no se cambió nada; el repositorio regresa a ${ANTERIOR:0:12}."; git checkout --quiet --detach "$ANTERIOR"; exit 1; }
+
+git fetch --quiet origin "$RAMA"
+git checkout --quiet --detach "origin/$RAMA"
+NUEVA=$(git rev-parse --short=12 HEAD)
+if [ "$NUEVA" = "$ACTUAL" ] && sano "$ACTUAL"; then echo "Ya está en $NUEVA."; exit 0; fi
+echo "CAPRI: $ACTUAL → $NUEVA"
+git --no-pager log --oneline "$ANTERIOR..HEAD" | head -20
+
+echo "== Construir y probar capri:$NUEVA (el servicio sigue con la anterior)"
+dk build -f Dockerfile --target pruebas -t "capri-pruebas:$NUEVA" .. || volver_git "no se pudo construir"
+dk run --rm --network none --read-only --tmpfs /tmp:size=256m,mode=1777 "capri-pruebas:$NUEVA" || volver_git "pruebas del servidor"
+dc "$NUEVA" build capri || volver_git "no se pudo construir la imagen final"
+
+echo "== Cambio"
+if cambiar_a "$NUEVA"; then
+  fijar "$NUEVA"
+  podar "$NUEVA"
+  echo "✔ CAPRI en capri:$NUEVA. Registro: docker logs -f capri   ·   regreso: $YO --regresar"
+  exit 0
+fi
+echo "✘ capri:$NUEVA no quedó sana: regreso a capri:$ACTUAL"
+dk logs --tail 40 capri 2>&1 | tail -40 || true
+if cambiar_a "$ACTUAL"; then echo "✔ de vuelta en capri:$ACTUAL"; else echo "✘ tampoco quedó sana capri:$ACTUAL: docker logs capri"; fi
+# La imagen que falló no se queda como candidata para --regresar
+dk image rm "capri:$NUEVA" "capri-pruebas:$NUEVA" >/dev/null 2>&1 || true
+git checkout --quiet --detach "$ANTERIOR"
+exit 1
diff --git a/servidor/despliegue/nginx-capri.helgen.online.conf b/servidor/despliegue/nginx-capri.helgen.online.conf
new file mode 100644
index 0000000..0f8f8f4
--- /dev/null
+++ b/servidor/despliegue/nginx-capri.helgen.online.conf
@@ -0,0 +1,133 @@
+# capri.helgen.online — API de CAPRI (etapa 1; docs/servidor-etapa-1.md §10.3). Lo instala despliegue/nginx-capri.sh
+# (respaldo, nginx -t, pruebas y regreso automático) en /etc/nginx/sites-available/capri.helgen.online.conf. Nunca toca el
+# archivo de drogheda.helgen.online: los nombres de zonas y variables de aquí empiezan con "capri".
+#
+# Certificado: certbot certonly --webroot (reto ACME en /var/www/letsencrypt). certbot NO edita este archivo (con
+# drogheda sí lo hizo: "managed by Certbot"); la renovación es la misma de drogheda (certbot.timer) y recarga nginx con
+# el --deploy-hook que guarda certbot en /etc/letsencrypt/renewal/capri.helgen.online.conf.
+#
+# Detrás: el contenedor capri en 127.0.0.1:8090 (servidor/docker-compose.yml). La interfaz sigue en Cloudflare y llama
+# POST text/plain a https://capri.helgen.online/api: petición "simple" (el navegador no manda OPTIONS antes). El servicio
+# pone Access-Control-Allow-Origin en sus respuestas; aquí, en las que contesta nginx (límite, archivo grande, reinicio).
+
+limit_req_zone $binary_remote_addr zone=capri_api:10m rate=10r/s;
+limit_req_zone $binary_remote_addr zone=capri_salud:1m rate=30r/m;
+
+# El único origen de navegador que puede leer las respuestas: la interfaz en Cloudflare. Con expresión regular a
+# propósito: como llave exacta, sus 54 caracteres no caben en map_hash_bucket_size (64) y nginx -t falla
+map $http_origin $capri_origen {
+    default "";
+    "~^https://cotizador-helgen\.cotizador-helgen\.workers\.dev$" $http_origin;
+}
+# Una llamada que trae Origin de otro sitio se rechaza aquí; sin Origin pasa (curl, la herramienta de sombra)
+map $http_origin $capri_origen_ajeno {
+    default 1;
+    "" 0;
+    "~^https://cotizador-helgen\.cotizador-helgen\.workers\.dev$" 0;
+}
+
+# ---- puerto 80 (nginx-capri.sh certificado instala solo este bloque para que certbot pueda emitir)
+server {
+    listen 80;
+    listen [::]:80;
+    server_name capri.helgen.online;
+    server_tokens off;
+
+    location ^~ /.well-known/acme-challenge/ {
+        root /var/www/letsencrypt;
+        default_type text/plain;
+    }
+    location / {
+        return 301 https://$host$request_uri;
+    }
+}
+# ---- fin del puerto 80
+
+server {
+    listen 443 ssl;
+    listen [::]:443 ssl;
+    server_name capri.helgen.online;
+    server_tokens off;
+
+    ssl_certificate /etc/letsencrypt/live/capri.helgen.online/fullchain.pem;
+    ssl_certificate_key /etc/letsencrypt/live/capri.helgen.online/privkey.pem;
+    include /etc/letsencrypt/options-ssl-nginx.conf;
+    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
+    add_header Strict-Transport-Security "max-age=31536000" always;
+
+    access_log /var/log/nginx/capri.access.log;
+    error_log /var/log/nginx/capri.error.log warn;
+
+    # Los archivos viajan en base64 dentro del JSON: un comprobante o una cotización de 10 MB son ~13.4 MB y una recepción
+    # trae una foto por renglón. 50 MB = el límite del propio servicio (limiteBytes); pasado eso, un JSON que la interfaz
+    # sí puede leer (@grande) en lugar de la página 413 de nginx
+    client_max_body_size 50m;
+    client_body_buffer_size 1m;
+
+    location = /api {
+        error_page 403 = @ajeno;
+        if ($capri_origen_ajeno) { return 403; }
+
+        # Por IP, como drogheda (zonas propias, burst sin espera, 429 → JSON). La oficina sale por una sola IP: holgado
+        # (cada pestaña consulta cada 20 s; un bootstrap y una ráfaga de guardados caben en el burst)
+        limit_req zone=capri_api burst=80 nodelay;
+        limit_req_status 429;
+        error_page 429 = @lento;
+        error_page 413 = @grande;
+        error_page 502 503 504 = @reiniciando;
+
+        proxy_pass http://127.0.0.1:8090/api;
+        proxy_http_version 1.1;
+        proxy_set_header Connection "";
+        proxy_set_header Host $host;
+        proxy_set_header X-Real-IP $remote_addr;
+        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
+        proxy_set_header X-Forwarded-Proto $scheme;
+        proxy_connect_timeout 5s;
+        # Guardar con PDF: ~15 s en Apps Script (aquí 0.3–0.8 s de Chromium); con fotos y correos, segundos. El servicio
+        # corta a los 120 s con su propio JSON ("TIEMPO"): nginx espera más para no cortar antes que él
+        proxy_read_timeout 180s;
+        proxy_send_timeout 180s;
+        proxy_request_buffering on;
+    }
+
+    # Desde fuera solo {"ok": true}; el detalle, dentro del contenedor: docker compose exec capri node herramientas/admin.js salud
+    location = /salud {
+        limit_req zone=capri_salud burst=10 nodelay;
+        limit_req_status 429;
+        proxy_pass http://127.0.0.1:8090/salud;
+        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
+        proxy_connect_timeout 5s;
+        proxy_read_timeout 10s;
+    }
+
+    location / {
+        return 404;
+    }
+
+    location @ajeno {
+        default_type application/json;
+        return 403 '{"ok":false,"codigo":"ORIGEN","error":"Esta API solo atiende a la interfaz de CAPRI."}';
+    }
+
+    location @lento {
+        default_type application/json;
+        add_header Access-Control-Allow-Origin $capri_origen always;
+        add_header Vary Origin always;
+        return 200 '{"ok":false,"codigo":"LIMITE","error":"Demasiadas llamadas seguidas desde esta conexión. Espera unos segundos y vuelve a intentar."}';
+    }
+
+    location @grande {
+        default_type application/json;
+        add_header Access-Control-Allow-Origin $capri_origen always;
+        add_header Vary Origin always;
+        return 200 '{"ok":false,"codigo":"GRANDE","error":"Los archivos pesan demasiado para una sola llamada (máx. 50 MB entre todos). Manda menos fotos a la vez o archivos más ligeros."}';
+    }
+
+    location @reiniciando {
+        default_type application/json;
+        add_header Access-Control-Allow-Origin $capri_origen always;
+        add_header Vary Origin always;
+        return 200 '{"ok":false,"codigo":"REINICIO","error":"CAPRI se está actualizando. Intenta de nuevo en un minuto; si guardabas algo, revisa antes de repetir."}';
+    }
+}
diff --git a/servidor/despliegue/nginx-capri.sh b/servidor/despliegue/nginx-capri.sh
new file mode 100755
index 0000000..ecc0dd5
--- /dev/null
+++ b/servidor/despliegue/nginx-capri.sh
@@ -0,0 +1,137 @@
+#!/usr/bin/env bash
+# nginx + HTTPS de capri.helgen.online (etapa 1). Se corre EN EL SERVIDOR con sudo, desde el repositorio:
+#   sudo bash servidor/despliegue/nginx-capri.sh certificado   # 1. solo el puerto 80 + certificado con certbot (una vez)
+#   sudo bash servidor/despliegue/nginx-capri.sh aplicar       # 2. el sitio completo (443 → 127.0.0.1:8090); si una prueba
+#                                                              #    falla, regresa solo a lo anterior
+#   sudo bash servidor/despliegue/nginx-capri.sh probar        #    solo las pruebas, sin cambiar nada
+#   sudo bash servidor/despliegue/nginx-capri.sh deshacer      #    quita el sitio de capri (el certificado se queda)
+#
+# Solo escribe en: /etc/nginx/sites-available/capri.helgen.online.conf, su enlace en sites-enabled/,
+# /etc/nginx/respaldos-capri/ y /var/www/letsencrypt/. Nunca toca drogheda.helgen.online: antes y después compara la
+# huella de nginx.conf y de los demás sitios habilitados; si alguna cambió, avisa y regresa.
+# Certificado: certbot certonly --webroot (certbot no edita el archivo de nginx); la renovación automática es la misma
+# que ya renueva drogheda (certbot.timer) y recarga nginx con el --deploy-hook que queda guardado.
+set -uo pipefail
+AQUI="$(cd "$(dirname "$0")" && pwd)"
+FUENTE="$AQUI/nginx-capri.helgen.online.conf"
+HOST=capri.helgen.online
+DISP=/etc/nginx/sites-available/capri.helgen.online.conf
+HAB=/etc/nginx/sites-enabled/capri.helgen.online.conf
+RESP_DIR=/etc/nginx/respaldos-capri
+RETO=/var/www/letsencrypt
+CERT=/etc/letsencrypt/live/$HOST/fullchain.pem
+[ "$(id -u)" = 0 ] || { echo "Córrelo con sudo."; exit 1; }
+[ -f "$FUENTE" ] || { echo "No encuentro $FUENTE."; exit 1; }
+
+ok=0; mal=0
+prueba() {  # nombre, esperado (subcadena), comando
+  local r; r="$(eval "$3" 2>&1)"
+  if [[ "$r" == *"$2"* ]]; then ok=$((ok+1)); echo "  ✓ $1"; else mal=$((mal+1)); echo "  ✕ $1 — esperaba «$2», obtuve: ${r:0:160}"; fi
+}
+C="curl -s --max-time 15 --resolve $HOST:443:127.0.0.1 --resolve $HOST:80:127.0.0.1"
+ORIGEN='Origin: https://cotizador-helgen.cotizador-helgen.workers.dev'
+
+# Huella de todo lo de nginx que NO es de capri (nginx.conf, conf.d y los demás sitios habilitados, por su destino real)
+huella_otros() {
+  { sha256sum /etc/nginx/nginx.conf
+    find /etc/nginx/sites-enabled /etc/nginx/conf.d -maxdepth 1 \( -type f -o -type l \) ! -name 'capri.helgen.online.conf' 2>/dev/null \
+      | sort | while read -r f; do sha256sum "$(readlink -f "$f")"; done; } | sha256sum | cut -c1-16
+}
+HUELLA0="$(huella_otros)"
+revisar_otros() {
+  local h; h="$(huella_otros)"
+  if [ "$h" != "$HUELLA0" ]; then echo "  ✕ cambió la configuración de otro sitio o de nginx.conf (esto no debía pasar)"; return 1; fi
+  echo "  ✓ los demás sitios (drogheda) siguen idénticos ($h)"
+}
+otro_dueno() {  # ¿otro archivo ya atiende capri.helgen.online?
+  grep -l "server_name[^;]*\b$HOST\b" /etc/nginx/sites-enabled/* /etc/nginx/conf.d/*.conf 2>/dev/null | while read -r f; do
+    [ "$(readlink -f "$f")" = "$DISP" ] || echo "$f"; done
+}
+respaldar() {
+  mkdir -p "$RESP_DIR"
+  RESP=""
+  if [ -f "$DISP" ]; then RESP="$RESP_DIR/capri.helgen.online.conf.$1-$(date +%Y%m%d-%H%M%S)"; cp -p "$DISP" "$RESP"; echo "Respaldo: $RESP"; fi
+}
+regresar() {  # al respaldo (o sin sitio de capri si no había)
+  if [ -n "${RESP:-}" ]; then cp -p "$RESP" "$DISP"; else rm -f "$HAB" "$DISP"; fi
+  nginx -t >/dev/null 2>&1 && systemctl reload nginx && echo "Regresé a lo anterior." || echo "✕ nginx -t falla aun después de regresar: revisa 'nginx -t' YA."
+}
+recargar() {
+  if ! nginx -t; then echo "nginx -t falló: regreso a lo anterior."; regresar; exit 1; fi
+  systemctl reload nginx; sleep 1
+}
+
+probar() {
+  echo "## nginx ($HOST)"
+  local servicio=no
+  curl -s --max-time 3 http://127.0.0.1:8090/salud | grep -q '"ok":true' && servicio=si
+  prueba "http → https" "301 https://$HOST/api" "$C -o /dev/null -w '%{http_code} %{redirect_url}' http://$HOST/api"
+  mkdir -p "$RETO/.well-known/acme-challenge"; echo "reto-capri" > "$RETO/.well-known/acme-challenge/prueba-capri"
+  prueba "reto de certbot por http" "reto-capri" "$C http://$HOST/.well-known/acme-challenge/prueba-capri"
+  rm -f "$RETO/.well-known/acme-challenge/prueba-capri"
+  if [ -f "$CERT" ] && [ -L "$HAB" ] && grep -q 'listen 443' "$DISP"; then
+    prueba "certificado de $HOST" "$HOST" "echo | openssl s_client -connect 127.0.0.1:443 -servername $HOST 2>/dev/null | openssl x509 -noout -subject -ext subjectAltName"
+    if [ "$servicio" = si ]; then
+      prueba "/salud desde fuera = solo {ok}" '{"ok":true}' "$C https://$HOST/salud"
+      prueba "API desde la interfaz (sin sesión → SESION)" '"codigo":"SESION"' "$C -H '$ORIGEN' -H 'Content-Type: text/plain;charset=utf-8' -d '{\"funcion\":\"bootstrap\",\"args\":[],\"token\":\"\"}' https://$HOST/api"
+    else
+      echo "  · el servicio capri no corre todavía (127.0.0.1:8090): se espera la respuesta de reinicio"
+      prueba "API con el servicio apagado → REINICIO en JSON" '"codigo":"REINICIO"' "$C -H '$ORIGEN' -d '{}' https://$HOST/api"
+    fi
+    prueba "CORS solo para la interfaz de Cloudflare" "access-control-allow-origin: https://cotizador-helgen.cotizador-helgen.workers.dev" \
+      "$C -D - -o /dev/null -H '$ORIGEN' -d '{}' https://$HOST/api | tr 'A-Z' 'a-z'"
+    prueba "otro origen → 403 ORIGEN" '"codigo":"ORIGEN"' "$C -H 'Origin: https://malo.example' -d '{}' https://$HOST/api"
+    prueba "/admin/correr no existe por nginx" "404" "$C -o /dev/null -w '%{http_code}' -d '{\"funcion\":\"cadaQuinceMinutos\"}' https://$HOST/admin/correr"
+    prueba "más de 50 MB → JSON GRANDE (la interfaz lo puede leer)" '"codigo":"GRANDE"' \
+      "head -c 52500000 /dev/zero | $C -H '$ORIGEN' --data-binary @- https://$HOST/api"
+  fi
+  revisar_otros || mal=$((mal+1))
+}
+
+case "${1:-}" in
+  certificado)
+    if [ -f "$CERT" ]; then echo "Ya existe el certificado de $HOST ($CERT): sigue con «aplicar»."; exit 0; fi
+    [ -z "$(otro_dueno)" ] || { echo "Otro archivo ya atiende $HOST: $(otro_dueno). No cambio nada."; exit 1; }
+    getent hosts "$HOST" >/dev/null || { echo "El DNS de $HOST no resuelve todavía. No cambio nada."; exit 1; }
+    respaldar antes-certificado
+    mkdir -p "$RETO/.well-known/acme-challenge"
+    # Solo el bloque del puerto 80 (reto ACME + redirección): el de 443 no carga sin certificado
+    sed -n '/^# ---- puerto 80/,/^# ---- fin del puerto 80/p' "$FUENTE" > "$DISP"
+    grep -q 'acme-challenge' "$DISP" || { echo "No pude sacar el bloque del puerto 80 de $FUENTE."; regresar; exit 1; }
+    ln -sf "$DISP" "$HAB"
+    recargar
+    ok=0; mal=0; probar
+    [ "$mal" = 0 ] || { echo "El puerto 80 no quedó bien ($mal): regreso."; regresar; exit 1; }
+    echo "== certbot (webroot $RETO)"
+    # ${CERTBOT_CORREO} solo hace falta si certbot no tiene cuenta todavía (con drogheda ya la tiene)
+    certbot certonly --webroot -w "$RETO" -d "$HOST" --non-interactive --keep-until-expiring \
+      --deploy-hook 'systemctl reload nginx' ${CERTBOT_CORREO:+--agree-tos -m "$CERTBOT_CORREO"} \
+      || { echo "certbot falló: el puerto 80 de capri se queda (sirve para reintentar). ¿Llega el puerto 80 desde Internet a esta máquina?"; exit 1; }
+    [ -f "$CERT" ] || { echo "certbot terminó pero no veo $CERT."; exit 1; }
+    echo "Certificado listo: $(openssl x509 -noout -enddate -in "$CERT"). Ahora: sudo bash $0 aplicar"
+    ;;
+  aplicar)
+    [ -f "$CERT" ] || { echo "Falta el certificado ($CERT): corre primero «certificado»."; exit 1; }
+    [ -f /etc/letsencrypt/options-ssl-nginx.conf ] && [ -f /etc/letsencrypt/ssl-dhparams.pem ] \
+      || { echo "Faltan /etc/letsencrypt/options-ssl-nginx.conf o ssl-dhparams.pem (los pone certbot --nginx; drogheda los usa)."; exit 1; }
+    [ -z "$(otro_dueno)" ] || { echo "Otro archivo ya atiende $HOST: $(otro_dueno). No cambio nada."; exit 1; }
+    respaldar antes-aplicar
+    install -m 644 "$FUENTE" "$DISP"
+    ln -sf "$DISP" "$HAB"
+    recargar
+    ok=0; mal=0; probar
+    if [ "$mal" != 0 ]; then echo "Algo falló ($mal): regreso a lo anterior."; regresar; exit 1; fi
+    echo; echo "Listo ($ok pruebas): https://$HOST/salud → {\"ok\":true}. Para quitarlo: sudo bash $0 deshacer"
+    ;;
+  probar)
+    probar; echo "$ok bien · $mal mal"; [ "$mal" = 0 ]
+    ;;
+  deshacer)
+    [ -e "$HAB" ] || [ -e "$DISP" ] || { echo "No hay sitio de capri instalado."; exit 0; }
+    respaldar quitado
+    rm -f "$HAB" "$DISP"
+    nginx -t && systemctl reload nginx && echo "Sitio de capri quitado (respaldo: ${RESP:-ninguno}). El certificado se queda en /etc/letsencrypt."
+    revisar_otros
+    ;;
+  *) sed -n '2,9p' "$0"; exit 1 ;;
+esac
diff --git a/servidor/despliegue/preparar-servidor.sh b/servidor/despliegue/preparar-servidor.sh
new file mode 100755
index 0000000..db38724
--- /dev/null
+++ b/servidor/despliegue/preparar-servidor.sh
@@ -0,0 +1,60 @@
+#!/usr/bin/env bash
+# Preparación de una sola vez en el servidor (helgensrvr), con sudo. Idempotente: se puede volver a correr.
+#   - usuario y grupo capri con UID/GID 10001 (el mismo de la imagen; es el dueño de config y datos)
+#   - /srv/capri/config (700: capri.json y los tokens de Google, 600) y /srv/capri/datos (700: propiedades, caché, estado)
+#   - /srv/capri/config/capri.json desde el ejemplo, en solo lectura (la primera corrida es la sombra, docs §12.1)
+#   - construye la imagen y la etiqueta con el commit (servidor/.env: CAPRI_VERSION)
+# NO arranca el servicio (faltan los tokens de Google y las propiedades) y NO toca nginx (despliegue/nginx-capri.sh).
+# No instala Node en el servidor: todo corre dentro de la imagen.
+#
+# Uso:  sudo bash servidor/despliegue/preparar-servidor.sh [/srv/projects/capri/app]
+set -euo pipefail
+APP=${1:-/srv/projects/capri/app}
+BASE=${CAPRI_BASE:-/srv/capri}
+ID_CAPRI=10001
+[ "$(id -u)" = 0 ] || { echo "Correr con sudo."; exit 1; }
+[ -f "$APP/Code.js" ] && [ -f "$APP/servidor/Dockerfile" ] || { echo "No encuentro el repositorio en $APP (Code.js y servidor/Dockerfile)."; exit 1; }
+command -v docker >/dev/null || { echo "Falta Docker."; exit 1; }
+docker compose version >/dev/null 2>&1 || { echo "Falta el plugin «docker compose» (paquete docker-compose-plugin)."; exit 1; }
+case "$(uname -m)" in
+  x86_64) ;;
+  aarch64) echo "⚠ arm64: no hay Chrome for Testing; la imagen usará el chromium de Debian (PDF a revisar en el ensayo)." ;;
+  *) echo "Arquitectura $(uname -m) no probada."; exit 1 ;;
+esac
+
+echo "== Usuario capri (UID/GID $ID_CAPRI)"
+if id capri >/dev/null 2>&1; then
+  [ "$(id -u capri)" = "$ID_CAPRI" ] || { echo "Ya existe un usuario capri con UID $(id -u capri), no $ID_CAPRI. Resolver a mano."; exit 1; }
+else
+  if getent passwd "$ID_CAPRI" >/dev/null; then echo "El UID $ID_CAPRI ya es de $(getent passwd "$ID_CAPRI" | cut -d: -f1). Construir con --build-arg CAPRI_UID=<otro> y ajustar este script."; exit 1; fi
+  getent group "$ID_CAPRI" >/dev/null && { echo "El GID $ID_CAPRI ya es del grupo $(getent group "$ID_CAPRI" | cut -d: -f1)."; exit 1; }
+  groupadd --system --gid "$ID_CAPRI" capri
+  useradd --system --uid "$ID_CAPRI" --gid capri --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin capri
+fi
+
+echo "== Carpetas fuera de la imagen"
+install -d -o root -g root -m 755 "$BASE"
+install -d -o capri -g capri -m 700 "$BASE/config" "$BASE/datos"
+if [ ! -f "$BASE/config/capri.json" ]; then
+  install -o capri -g capri -m 600 "$APP/servidor/config.ejemplo.json" "$BASE/config/capri.json"
+  echo "   $BASE/config/capri.json creado desde el ejemplo (soloLectura: true)"
+fi
+# Lo que alguien haya copiado a mano queda con dueño y permisos correctos (nunca legible por otros)
+find "$BASE/config" "$BASE/datos" -type f -exec chown capri:capri {} + -exec chmod 600 {} +
+ls -ln "$BASE" "$BASE/config" "$BASE/datos"
+
+echo "== Imagen"
+VERSION=$(git -c safe.directory="$APP" -C "$APP" rev-parse --short=12 HEAD)
+cd "$APP/servidor"
+CAPRI_VERSION="$VERSION" docker compose build
+DUENO=$(stat -c %U "$APP")
+{ echo "CAPRI_VERSION=$VERSION"; echo "CAPRI_CONFIG_DIR=$BASE/config"; echo "CAPRI_DATOS_DIR=$BASE/datos"; } > .env
+chown "$DUENO" .env
+echo "   capri:$VERSION construida (servidor/.env)"
+BASE_IMG=$(sed -n 's/^ARG NODE_IMAGE=//p' Dockerfile)
+echo "   imagen base: $(docker image inspect --format '{{index .RepoDigests 0}}' "${BASE_IMG%%@*}" 2>/dev/null || echo "$BASE_IMG")"
+echo "   (para fijarla del todo, pon ese digest en ARG NODE_IMAGE del Dockerfile)"
+
+echo
+echo "Listo. Falta (docs/servidor-comandos.md): tokens de Google en $BASE/config, propiedades en $BASE/datos,"
+echo "nginx (sudo bash servidor/despliegue/nginx-capri.sh certificado; … aplicar) y arrancar: cd $APP/servidor && docker compose up -d"
diff --git a/servidor/despliegue/revisar-servidor.sh b/servidor/despliegue/revisar-servidor.sh
new file mode 100755
index 0000000..5645f25
--- /dev/null
+++ b/servidor/despliegue/revisar-servidor.sh
@@ -0,0 +1,60 @@
+#!/usr/bin/env bash
+# Revisión del servidor (helgensrvr) antes de instalar CAPRI en Docker. Solo lee: no instala ni cambia nada.
+# Uso: sudo bash servidor/despliegue/revisar-servidor.sh 2>&1 | tee revision-servidor.txt
+#      (sin sudo también corre, pero no ve puertos con proceso, firewall ni certificados)
+set -u
+seccion() { printf '\n== %s\n' "$1"; }
+
+seccion "Sistema"
+uname -a
+grep PRETTY_NAME /etc/os-release
+echo "Arquitectura: $(uname -m)  (x86_64 = Chrome for Testing en la imagen; aarch64 = chromium de Debian)"
+echo "CPU: $(nproc)"
+free -h
+df -h /srv /var/lib/docker /tmp 2>/dev/null
+
+seccion "Hora (Code.js trabaja en America/Mexico_City; el contenedor la fija con TZ)"
+timedatectl 2>/dev/null | grep -E 'Time zone|System clock synchronized|NTP service' || date
+
+seccion "Docker"
+docker version --format 'cliente {{.Client.Version}} · servidor {{.Server.Version}}' 2>&1 | head -2
+docker compose version 2>&1 | head -1
+docker info --format 'almacenamiento {{.Driver}} · cgroup {{.CgroupDriver}} v{{.CgroupVersion}} · raíz {{.DockerRootDir}} · contenedores {{.Containers}}' 2>&1 | head -1
+systemctl is-enabled docker 2>/dev/null | sed 's/^/docker al arrancar el servidor: /'
+id -nG "${SUDO_USER:-$USER}" | grep -qw docker && echo "${SUDO_USER:-$USER} está en el grupo docker" || echo "${SUDO_USER:-$USER} NO está en el grupo docker (usará sudo docker)"
+
+seccion "nginx y certbot"
+nginx -v 2>&1
+certbot --version 2>/dev/null || echo "sin certbot"
+ls -l /etc/nginx/sites-enabled 2>/dev/null
+grep -l 'capri.helgen.online' /etc/nginx/sites-enabled/* 2>/dev/null && echo "⚠ ya hay un sitio con capri.helgen.online" || echo "ningún sitio habilitado usa capri.helgen.online (bien)"
+ls /etc/letsencrypt/options-ssl-nginx.conf /etc/letsencrypt/ssl-dhparams.pem 2>&1
+ls /etc/letsencrypt/live 2>&1
+systemctl list-timers 'certbot*' --no-pager 2>/dev/null | head -3
+systemctl is-active nginx actas-hbox 2>/dev/null | paste -sd' ' -
+
+seccion "Puertos (CAPRI publicará solo 127.0.0.1:8090)"
+ss -ltnp 2>/dev/null | grep -E ':(80|443|8081|8090)\b' || echo "(nada en esos puertos o ss sin permisos)"
+
+seccion "Firewall"
+ufw status 2>/dev/null | head -12 || echo "(sin ufw o sin sudo)"
+
+seccion "DNS"
+getent hosts capri.helgen.online drogheda.helgen.online || true
+ip -4 -brief addr 2>/dev/null | grep -v '^lo' | head -5
+
+seccion "Salida a Internet (debe dar un código HTTP rápido, nunca 000)"
+for u in https://sheets.googleapis.com/ https://www.googleapis.com/ https://oauth2.googleapis.com/ https://gmail.googleapis.com/ \
+         https://registry-1.docker.io/v2/ https://registry.npmjs.org/ https://storage.googleapis.com/chrome-for-testing-public/ \
+         https://deb.debian.org/debian/; do
+  curl -s -o /dev/null -m 10 -w "%{http_code}  %{time_total}s  $u\n" "$u" || echo "000  SIN SALIDA  $u"
+done
+echo "-- el centro de mando por su nombre público (desde el contenedor se usará la puerta del servidor: extra_hosts)"
+curl -s -o /dev/null -m 10 -w "%{http_code}  %{time_total}s  https://drogheda.helgen.online/api/salud\n" https://drogheda.helgen.online/api/salud || echo "sin respuesta"
+
+seccion "Usuario y carpetas de CAPRI (UID/GID 10001; antes de instalar no deben existir)"
+id capri 2>/dev/null || echo "sin usuario capri"
+getent passwd 10001 || echo "UID 10001 libre"
+getent group 10001 || echo "GID 10001 libre"
+ls -ld /srv/projects /srv/projects/capri /srv/capri /srv/capri/config /srv/capri/datos 2>&1
+docker ps -a --filter name=^capri$ --format 'contenedor capri: {{.Image}} · {{.Status}}' 2>/dev/null
diff --git a/servidor/docker-compose.yml b/servidor/docker-compose.yml
new file mode 100644
index 0000000..09f1ce0
--- /dev/null
+++ b/servidor/docker-compose.yml
@@ -0,0 +1,55 @@
+# CAPRI — etapa 1 en Docker, detrás del nginx del servidor (docs/servidor-etapa-1.md §10; comandos en
+# docs/servidor-comandos.md). Se usa desde esta carpeta (servidor/):
+#   docker compose build && docker compose up -d
+#   docker compose exec capri node herramientas/admin.js salud
+# CAPRI_VERSION (en servidor/.env, lo escribe despliegue/actualizar.sh) = la etiqueta de la imagen que corre; las
+# anteriores se quedan para regresar con `despliegue/actualizar.sh --regresar`.
+#
+# Fuera de la imagen (nunca en el repositorio ni en la imagen):
+#   /srv/capri/config  → /etc/capri (solo lectura): capri.json y los dos tokens de Google; carpeta 700, archivos 600,
+#                        dueño capri (UID 10001, el mismo de la imagen)
+#   /srv/capri/datos   → /var/lib/capri: propiedades.json (Script Properties, con secretos), cache.json, estado.json
+name: capri
+
+services:
+  capri:
+    image: capri:${CAPRI_VERSION:-local}
+    build:
+      context: ..
+      dockerfile: servidor/Dockerfile
+      target: app
+    container_name: capri
+    restart: unless-stopped
+    # tini como PID 1: recoge los procesos de Chromium y pasa SIGTERM al servicio (apagado en orden, §5)
+    init: true
+    stop_grace_period: 45s
+    environment:
+      # Dentro del contenedor escucha en todas sus interfaces; hacia fuera solo 127.0.0.1 del servidor (ports)
+      CAPRI_HOST: 0.0.0.0
+      CAPRI_PUERTO: "8090"
+      TZ: America/Mexico_City
+    ports:
+      - "127.0.0.1:8090:8090"
+    volumes:
+      - ${CAPRI_CONFIG_DIR:-/srv/capri/config}:/etc/capri:ro
+      - ${CAPRI_DATOS_DIR:-/srv/capri/datos}:/var/lib/capri
+    # Solo escribe en /var/lib/capri y en /tmp (Chromium); el código y node_modules son de solo lectura
+    read_only: true
+    tmpfs:
+      - /tmp:size=512m,mode=1777
+    cap_drop: [ALL]
+    security_opt:
+      - no-new-privileges:true
+    # Presupuesto (docs §11): ~350 MB normal, ~800 MB con PDF y fotos grandes a la vez
+    mem_limit: 1200m
+    memswap_limit: 1200m
+    pids_limit: 512
+    # El centro de mando está en esta misma máquina: se le habla por la puerta del servidor (nginx con su certificado),
+    # sin depender de que el ruteador regrese el tráfico a su propia IP pública
+    extra_hosts:
+      - "drogheda.helgen.online:host-gateway"
+    logging:
+      driver: json-file
+      options:
+        max-size: "10m"
+        max-file: "5"
diff --git a/servidor/herramientas/admin.js b/servidor/herramientas/admin.js
new file mode 100644
index 0000000..7cd33c1
--- /dev/null
+++ b/servidor/herramientas/admin.js
@@ -0,0 +1,50 @@
+#!/usr/bin/env node
+// Administración del servicio DESDE DENTRO del contenedor (ahí 127.0.0.1 es el servicio mismo; desde el servidor o por
+// nginx, /salud solo dice {"ok":true} y /admin/correr no existe):
+//
+//   docker compose exec capri node herramientas/admin.js salud                 detalle: trabajadores, libros, cuota, memoria
+//   docker compose exec capri node herramientas/admin.js correr cadaQuinceMinutos [args JSON]   como "Ejecutar" en el editor
+//   node herramientas/admin.js salud --callado      lo usa el HEALTHCHECK de la imagen: sale 0 si está sano, 1 si no
+'use strict';
+
+const puerto = Number(process.env.CAPRI_PUERTO || 8090);
+const base = 'http://127.0.0.1:' + puerto;
+const [, , accion, ...resto] = process.argv;
+const callado = resto.includes('--callado');
+
+async function salud() {
+  let x;
+  try {
+    const r = await fetch(base + '/salud', { signal: AbortSignal.timeout(4000) });
+    x = await r.json();
+  } catch (e) {
+    if (!callado) console.error('✘ CAPRI no contesta en ' + base + ': ' + e.message);
+    return 1;
+  }
+  const trabajadores = (x.trabajadores && x.trabajadores.trabajadores) || [];
+  const sano = x.ok === true && trabajadores.length > 0 && trabajadores.every(t => t.listo);
+  if (!callado) {
+    console.log(JSON.stringify(x, null, 1));
+    console.log(sano ? '✔ sano' : '✘ no está sano (¿trabajadores sin cargar?)');
+  }
+  return sano ? 0 : 1;
+}
+
+async function correr(funcion, argsTexto) {
+  if (!funcion) { console.error('Uso: admin.js correr <función> [args JSON, p. ej. \'["x", 1]\']'); return 2; }
+  let args = [];
+  if (argsTexto) {
+    try { args = JSON.parse(argsTexto); } catch (e) { console.error('Los argumentos deben ser JSON: ' + e.message); return 2; }
+  }
+  const r = await fetch(base + '/admin/correr', { method: 'POST', body: JSON.stringify({ funcion, args }), signal: AbortSignal.timeout(330000) });
+  const texto = await r.text();
+  console.log(texto);
+  try { return JSON.parse(texto).ok ? 0 : 1; } catch (e) { return 1; }
+}
+
+(async () => {
+  if (accion === 'salud') return salud();
+  if (accion === 'correr') return correr(resto[0], resto[1]);
+  console.error('Uso: admin.js salud [--callado] | correr <función> [args JSON]');
+  return 2;
+})().then(c => process.exit(c), e => { console.error(e.message); process.exit(1); });
diff --git a/servidor/herramientas/autorizar.js b/servidor/herramientas/autorizar.js
new file mode 100755
index 0000000..6a2f651
--- /dev/null
+++ b/servidor/herramientas/autorizar.js
@@ -0,0 +1,78 @@
+#!/usr/bin/env node
+// Autoriza al servidor a usar Sheets, Drive y Gmail como facilities@helgen.tech (modo "oauth", el recomendado).
+// Se corre UNA vez (y otra si un día se revoca el permiso), con una ventana de navegador donde se entra como
+// facilities@. Guarda {"type":"authorized_user", client_id, client_secret, refresh_token} con permisos 600.
+//
+//   node herramientas/autorizar.js --cliente client_secret_XXXX.json --alcances hojas,drive --salida google-facilities.json
+//   node herramientas/autorizar.js --cliente client_secret_XXXX.json --alcances correo      --salida google-facilities-correo.json
+//
+// En el servidor (sin navegador), dentro de la imagen de CAPRI (Node solo existe ahí): túnel desde la Mac y la liga que
+// imprime se abre en el navegador de la Mac, entrando como facilities@ (docs/servidor-google-paso-a-paso.md, paso 7):
+//   ssh -L 8765:127.0.0.1:8765 <usuario>@helgensrvr
+//   docker compose run --rm -p 127.0.0.1:8765:8765 -v /srv/capri/config:/salida capri node herramientas/autorizar.js \
+//     --cliente /salida/cliente-oauth.json --alcances hojas,drive --salida /salida/google-facilities.json --escuchar 0.0.0.0
+// --escuchar 0.0.0.0: dentro del contenedor (Docker publica solo 127.0.0.1:8765 del servidor). La dirección de regreso
+// sigue siendo http://127.0.0.1:8765/oauth (la que acepta Google para una "App de escritorio").
+// El cliente OAuth es de tipo "App de escritorio" en el proyecto de Google Cloud de helgen.tech (pantalla de
+// consentimiento Interna).
+'use strict';
+const fs = require('fs');
+const http = require('http');
+const crypto = require('crypto');
+const { OAuth2Client } = require('google-auth-library');
+
+const ALCANCES = {
+  hojas: 'https://www.googleapis.com/auth/spreadsheets',
+  drive: 'https://www.googleapis.com/auth/drive',
+  correo: 'https://www.googleapis.com/auth/gmail.send',
+};
+const arg = n => { const i = process.argv.indexOf('--' + n); return i === -1 ? null : process.argv[i + 1]; };
+const cliente = arg('cliente'), salida = arg('salida');
+const alcances = String(arg('alcances') || 'hojas,drive,correo').split(',').map(x => x.trim()).filter(Boolean);
+const cuenta = arg('cuenta') || 'facilities@helgen.tech';
+const puerto = Number(arg('puerto') || 8765);
+const escuchar = arg('escuchar') || '127.0.0.1';
+if (!cliente || !salida || alcances.some(a => !ALCANCES[a])) {
+  console.error('Uso: autorizar.js --cliente client_secret.json --salida archivo.json [--alcances hojas,drive,correo] [--cuenta facilities@helgen.tech] [--escuchar 0.0.0.0]');
+  process.exit(2);
+}
+const c = JSON.parse(fs.readFileSync(cliente, 'utf8'));
+const datos = c.installed || c.web;
+if (!datos) { console.error('El archivo no es un cliente OAuth (falta "installed").'); process.exit(2); }
+const redirect = 'http://127.0.0.1:' + puerto + '/oauth';
+const oauth = new OAuth2Client({ clientId: datos.client_id, clientSecret: datos.client_secret, redirectUri: redirect });
+const verificador = crypto.randomBytes(48).toString('base64url');
+const reto = crypto.createHash('sha256').update(verificador).digest('base64url');
+const estado = crypto.randomBytes(16).toString('hex');
+const url = oauth.generateAuthUrl({ access_type: 'offline', prompt: 'consent', login_hint: cuenta, state: estado,
+  scope: ['openid', 'email'].concat(alcances.map(a => ALCANCES[a])), code_challenge: reto, code_challenge_method: 'S256' });
+
+const servidor = http.createServer(async (req, res) => {
+  const u = new URL(req.url, redirect);
+  if (u.pathname !== '/oauth') { res.writeHead(404); res.end(); return; }
+  try {
+    if (u.searchParams.get('state') !== estado) throw new Error('estado distinto (¿otra pestaña?)');
+    if (u.searchParams.get('error')) throw new Error(u.searchParams.get('error'));
+    const { tokens } = await oauth.getToken({ code: u.searchParams.get('code'), codeVerifier: verificador });
+    const ticket = await oauth.verifyIdToken({ idToken: tokens.id_token, audience: datos.client_id });
+    const correo = ticket.getPayload().email;
+    if (correo !== cuenta) throw new Error('entraste como ' + correo + ', no como ' + cuenta + '. Vuelve a correrlo con la cuenta correcta.');
+    if (!tokens.refresh_token) throw new Error('Google no mandó refresh_token (quita el acceso de la app en la cuenta y vuelve a intentar).');
+    const faltan = alcances.filter(a => !String(tokens.scope || '').includes(ALCANCES[a]));
+    if (faltan.length) throw new Error('no se aceptaron estos permisos: ' + faltan.join(', '));
+    fs.writeFileSync(salida, JSON.stringify({ type: 'authorized_user', client_id: datos.client_id, client_secret: datos.client_secret,
+      refresh_token: tokens.refresh_token, cuenta: correo, alcances, creado: new Date().toISOString() }, null, 1), { mode: 0o600 });
+    res.writeHead(200, { 'Content-Type': 'text/plain; charset=utf-8' });
+    res.end('Listo: ' + salida + ' guardado para ' + correo + '. Puedes cerrar esta ventana.');
+    console.log('✔ Guardado ' + salida + ' (' + alcances.join(', ') + ') para ' + correo + ', con permisos 600.');
+  } catch (e) {
+    res.writeHead(400, { 'Content-Type': 'text/plain; charset=utf-8' });
+    res.end('No se pudo: ' + e.message);
+    console.error('✘ ' + e.message);
+    process.exitCode = 1;
+  }
+  setTimeout(() => servidor.close(), 200);
+});
+servidor.listen(puerto, escuchar, () => {
+  console.log('Abre esta liga en el navegador (entra como ' + cuenta + '):\n\n' + url + '\n');
+});
