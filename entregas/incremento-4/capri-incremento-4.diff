+function correosDeAviso_(aviso, memo) {
+  const tipo = aviso.tipo, d = aviso.datos || {}, actor = String(aviso.actor || '').toLowerCase();
+  if (EVENTOS_CORREO.indexOf(tipo) === -1) throw new Error('Tipo de aviso desconocido: ' + tipo + '.');
