+    .replace(/(?:US\$|MX\$|\$)\s*\d[\d.,]*(?:\s*(?:MXN|USD|M\.N\.|pesos|d[oó]lares))?/gi, '[monto]')
+    .replace(/\b\d[\d.,]*\s*(?:MXN|USD|pesos|d[oó]lares)(?![a-z])/gi, '[monto]');
