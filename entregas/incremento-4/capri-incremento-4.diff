+        aviso('ok', 'Se anuló <b>' + esc(r.folio) + '</b>' + (r.registros.length > 1 ? ' y ' + (r.registros.length - 1) + ' registro(s) más' : '') + '.' +
+          (distinto ? ' <br>Ojo: alguien cambió algo entre la vista previa y la confirmación; se anuló: ' + r.registros.map(x => esc(x.folio)).join(', ') + '.' : '') +
+          (r.fallas && r.fallas.length ? '<br>No se pudo renombrar en Drive: ' + r.fallas.map(esc).join(' · ') : ''));
+        limpiarVista(); q('#anuFolio').value = '';
