+        .previsualizarAnulacion(folio);
+    }
+
+    const filaRegistro = (r, i) => '<tr' + (i === 0 ? ' style="font-weight:bold"' : '') + '><td>' + esc(r.tipo) + '</td><td>' + esc(r.folio) +
+      '</td><td>' + esc(r.descripcion) + '</td><td>' + (r.estado ? '<span class="chip">' + esc(r.estado) + '</span>' : '') + '</td></tr>';
+    const lista = (titulo, cosas) => cosas && cosas.length
+      ? '<p style="margin:12px 0 4px"><b>' + titulo + '</b></p><ul style="margin:0;padding-left:18px">' + cosas.map(x => '<li>' + esc(x) + '</li>').join('') + '</ul>' : '';
+
+    function pintarVista(r, folio) {
+      $('aviso').className = 'aviso';
+      est.vista = r; est.folio = folio; est.id = nuevoId(); // un id por vista previa: un doble clic no anula dos veces
