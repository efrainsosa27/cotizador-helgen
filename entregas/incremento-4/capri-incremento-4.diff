+
+/** Firma (base64url sin relleno) de los datos de una sesión de CAPRI. */
+function firmaSesion_(datos, secreto) {
+  return Utilities.base64EncodeWebSafe(Utilities.computeHmacSha256Signature(datos, secreto)).replace(/=+$/, '');
