+    // primero (así nunca ve un pago o un envío antes de la autorización); si lo que se avisa es la cancelación, no hay nada que
+    // cancelar allá.
+    if (tipo !== 'oc.autorizada' && !avisoPortalExiste_(libro, orden.folio + ':oc.autorizada:')) {
