+/** ¿Una orden de compra cuenta (margen, costos, pendientes)? Ni las canceladas ni las anuladas. (Lógica pura) */
+function ocVigente(o) {
+  return !!o && o.estado !== OC_CANCELADA && o.estado !== ESTADO_ANULADA;
