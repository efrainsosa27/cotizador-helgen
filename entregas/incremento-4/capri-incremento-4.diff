+    if (!correo || Date.now() - inicio > 120000) return;
+    const antes = VENDEDOR_;
+    VENDEDOR_ = { email: correo, nombre: '', apellido: '' };
+    try { fn(); hechos.push(que); } catch (e) { console.warn('Caché de ' + que + ': ' + e.message); } finally { VENDEDOR_ = antes; }
