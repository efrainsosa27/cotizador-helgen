+    }
+
+    function cargarLista() {
+      if (!est.montado) return;
+      est.buscar = q('#anuBuscar').value.trim();
+      const pedido = est.buscar;
+      google.script.run.withSuccessHandler(l => { if (pedido === est.buscar) pintarLista(l); })
+        .withFailureHandler(err => { q('#anuLista').innerHTML = '<p class="nota">No se pudo cargar: ' + esc(err && err.message ? err.message : err) + '</p>'; })
+        .listarAnulados(pedido);
+    }
+
+    function pintarLista(l) {
+      est.lista = l || [];
+      if (!est.montado) return;
+      if (!est.lista.length) {
+        q('#anuLista').innerHTML = '<p class="nota">' + (est.buscar ? 'Nada anulado con «' + esc(est.buscar) + '».' : 'Todavía no se ha anulado nada.') + '</p>';
+        return;
+      }
+      q('#anuLista').innerHTML = '<table><thead><tr><th>Fecha</th><th>Anulado</th><th>Quién</th><th>Motivo</th><th>Lo que arrastró</th></tr></thead><tbody>' +
+        est.lista.map(x => '<tr style="vertical-align:top"><td style="white-space:nowrap">' + esc(x.fecha) + '</td>' +
+          '<td><b>' + esc(x.folio) + '</b><br><span class="nota">' + esc(x.tipo) + '</span>' +
+            (x.descripcion ? '<br><span class="nota">' + esc(x.descripcion) + '</span>' : '') + '</td>' +
+          '<td>' + esc(x.nombre || x.correo) + (x.nombre && x.nombre !== x.correo ? '<br><span class="nota">' + esc(x.correo) + '</span>' : '') + '</td>' +
+          '<td>' + esc(x.motivo) + '</td>' +
+          '<td><details><summary>' + x.registros.length + ' registro(s)' + (x.archivos ? ' · ' + x.archivos + ' archivo(s)' : '') + '</summary>' +
+            '<ul style="margin:6px 0 0;padding-left:18px">' + x.registros.map(y => '<li>' + esc(y.tipo) + ' <b>' + esc(y.folio) + '</b>' +
