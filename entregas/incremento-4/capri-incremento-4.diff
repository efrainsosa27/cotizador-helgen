+    const n = String(p || '').replace(/\s+/g, ' ').trim();
+    if (n.length >= 3) t = t.replace(new RegExp(n.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'), 'gi'), '[proveedor]');
+  });
+  return t.slice(0, 500);
+}
