+            (x.efectos && x.efectos.length ? '<p class="nota" style="margin:6px 0 0">' + x.efectos.map(esc).join('<br>') + '</p>' : '') +
+            (x.carpeta ? '<p class="nota" style="margin:6px 0 0">Carpeta: ANULADO — ' + esc(x.carpeta) + '</p>' : '') +
+          '</details></td></tr>').join('') +
+        '</tbody></table>' + (est.lista.length >= 200 ? '<p class="nota">Se muestran los 200 más recientes: busca para ver otros.</p>' : '');
+    }
+
+    registrarModulo({
+      nombre: 'Anular',
+      alPermisos(permisos) {
+        if (!permisos || !permisos.superadmin) { if (caja()) caja().innerHTML = ''; est.montado = false; est.vista = null; est.lista = null; }
+      },
+      alVerTab(t) {
+        if (t !== 'admin' || !esSuper()) return;
+        montar();
+        if (!est.lista) cargarLista();
+      },
+      // La sincronización manda la lista otra vez cuando alguien anula algo (con la búsqueda de esta página)
+      contexto() { return esSuper() && est.montado && TAB === 'admin' ? { anulados: true, anuladosBuscar: est.buscar } : {}; },
+      alSincronizar(r) { if (r && r.anulados && est.montado) pintarLista(r.anulados); },
