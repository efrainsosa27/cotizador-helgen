+      motivo.focus();
+    }
+
+    function confirmar() {
+      if (!est.vista || est.enviando) return;
+      const motivo = q('#anuMotivo').value.trim();
+      if (motivo.length < MOTIVO_MIN) { aviso('error', 'Escribe el motivo de la anulación (al menos ' + MOTIVO_MIN + ' caracteres).'); return; }
