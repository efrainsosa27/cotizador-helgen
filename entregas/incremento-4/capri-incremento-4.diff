+        (r.carpeta ? '<p class="nota">Carpeta del proyecto: «' + esc(r.carpeta) + '» → «ANULADO — ' + esc(r.carpeta) + '».</p>' : '') +
+        lista('Ten en cuenta', r.avisos) +
+        (r.para && r.para.length ? '<p class="nota">Se avisará a: ' + r.para.map(esc).join(', ') + '.</p>' : '') +
+        '<div style="margin-top:14px"><label for="anuMotivo">Motivo de la anulación (al menos ' + MOTIVO_MIN + ' caracteres; queda en el registro)</label>' +
+          '<textarea id="anuMotivo" rows="2" maxlength="500"></textarea></div>' +
+        '<div class="acciones"><button type="button" class="btn" id="anuConfirmar" disabled>Anular ' + n + ' registro' + (n > 1 ? 's' : '') + '</button>' +
+          '<button type="button" class="btn btn-sec" id="anuCancelar">Cancelar</button><span class="nota" id="anuCuenta"></span></div>';
+      const motivo = q('#anuMotivo'), boton = q('#anuConfirmar');
+      const contar = () => {
+        const k = motivo.value.trim().length;
+        boton.disabled = est.enviando || k < MOTIVO_MIN;
+        q('#anuCuenta').textContent = k < MOTIVO_MIN ? 'Faltan ' + (MOTIVO_MIN - k) + ' caracteres del motivo.' : '';
+      };
+      motivo.addEventListener('input', contar);
+      boton.addEventListener('click', confirmar);
+      q('#anuCancelar').addEventListener('click', () => { limpiarVista(); q('#anuFolio').value = ''; });
